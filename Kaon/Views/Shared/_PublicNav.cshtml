@* The public navigation bar. Shared by the landing page, login and sign-up. *@
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<header class="lp-nav">
    <div class="wrap lp-nav-in">
        <a class="lp-brand" href="/" aria-label="Kaon home"><partial name="_Mark" /><span>kaon</span></a>
        <nav class="lp-links" aria-label="Sections">
            <a href="/" class="lp-home">Home</a>
            <a href="/#how">How it works</a>
            <a href="/#owners">For carinderias</a>
            <a href="/#why">Why Kaon</a>
        </nav>
        <div class="lp-actions">
            @if (signedIn)
            {
                <a class="lp-btn" asp-controller="Account" asp-action="Login">Go to my account</a>
            }
            else
            {
                <a class="lp-link" asp-controller="Account" asp-action="Login">Log in</a>
                <a class="lp-btn" asp-controller="Account" asp-action="Register">Sign up</a>
            }
        </div>
    </div>
</header>
