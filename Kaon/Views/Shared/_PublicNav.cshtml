@* The public navigation bar. On Kaon's main pages it speaks to carinderia owners.
   On a carinderia's own pages (after opening its link or QR) it is that carinderia's bar for its customers. *@
@inject Kaon.Data.KaonDbContext Db
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    string? storeName = null;
    if (Context.Session.GetInt32("storeId") is int linkedId)
        storeName = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.FirstOrDefaultAsync(
            System.Linq.Queryable.Select(System.Linq.Queryable.Where(Db.StoreSettings, s => s.Id == linkedId), s => s.Name));
}
<header class="lp-nav">
    <div class="wrap lp-nav-in">
        <a class="lp-brand" href="/" aria-label="Kaon home"><partial name="_Mark" /><span>kaon</span></a>
        @if (storeName != null)
        {
            <nav class="lp-links" aria-label="Carinderia"><span style="font-weight:600">@storeName</span></nav>
        }
        else
        {
            <nav class="lp-links" aria-label="Sections">
                <a href="/" class="lp-home">Home</a>
                <a href="/#how">How it works</a>
                <a href="/#owners">For carinderias</a>
                <a href="/#why">Why Kaon</a>
            </nav>
        }
        <div class="lp-actions">
            @if (signedIn)
            {
                <a class="lp-btn" asp-controller="Account" asp-action="Login">Go to my account</a>
            }
            else if (storeName != null)
            {
                <a class="lp-link" asp-controller="Account" asp-action="Login">Log in</a>
                <a class="lp-btn" asp-controller="Account" asp-action="Register">Sign up</a>
            }
            else
            {
                <a class="lp-link" asp-controller="Account" asp-action="Login">Log in</a>
                <a class="lp-btn" asp-controller="Apply" asp-action="Index">Sign up</a>
            }
        </div>
    </div>
</header>
