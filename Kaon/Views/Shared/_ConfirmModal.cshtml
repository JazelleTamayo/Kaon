@* Small "still preparing, wait for it?" confirm panel used by the daily menu. *@
<div class="confirm-overlay" id="confirmModal" hidden>
    <div class="confirm-box" role="alertdialog" aria-modal="true" aria-labelledby="confirmText">
        <p id="confirmText"></p>
        <div class="confirm-actions">
            <button type="button" class="btn-ghost" data-confirm-no>Cancel</button>
            <button type="button" class="btn btn-sm" data-confirm-yes>Wait for it</button>
        </div>
    </div>
</div>
