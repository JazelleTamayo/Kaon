@model StoreSettings
@* Where to send the money: QR code, GCash and bank details. Used at checkout and on the order page. *@
<div class="pay-grid">
    @if (!string.IsNullOrEmpty(Model.PaymentQr))
    {
        <figure class="pay-qr">
            <img src="@Url.Action("Qr", "Payment", new { storeId = Model.Id, v = Model.PaymentQr })" alt="QR code to scan and pay" loading="lazy" />
            <figcaption>Scan to pay</figcaption>
            <a href="@Url.Action("Qr", "Payment", new { storeId = Model.Id })" download="kaon-payment-qr">Save QR</a>
        </figure>
    }
    <div class="pay-accounts">
        @if (!string.IsNullOrWhiteSpace(Model.GCashNumber))
        {
            <div class="pay-account">
                <span class="pa-title">GCash</span>
                @if (!string.IsNullOrWhiteSpace(Model.GCashName))
                {
                    <div class="pa-name">@Model.GCashName</div>
                }
                <div class="pa-num">
                    <strong>@Model.GCashNumber</strong>
                    <button type="button" class="copy-btn" data-copy="@Model.GCashNumber">Copy</button>
                </div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.BankAccountNumber))
        {
            <div class="pay-account">
                <span class="pa-title">@(string.IsNullOrWhiteSpace(Model.BankName) ? "Bank" : Model.BankName)</span>
                @if (!string.IsNullOrWhiteSpace(Model.BankAccountName))
                {
                    <div class="pa-name">@Model.BankAccountName</div>
                }
                <div class="pa-num">
                    <strong>@Model.BankAccountNumber</strong>
                    <button type="button" class="copy-btn" data-copy="@Model.BankAccountNumber">Copy</button>
                </div>
            </div>
        }
    </div>
</div>
@if (!string.IsNullOrWhiteSpace(Model.PaymentNote))
{
    <p class="muted" style="margin:8px 0 0">@Model.PaymentNote</p>
}
