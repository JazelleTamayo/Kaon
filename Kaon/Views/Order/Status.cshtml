@model Order
@using Kaon.Helpers
@{
    ViewData["Title"] = "Order #" + Model.Id;
    var steps = OrderText.Steps(Model);
    var currentIndex = steps.IndexOf(Model.Status);
}

<h1>Order #@Model.Id</h1>
<p class="muted">
    @(Model.OrderType == OrderType.Pickup ? "Pickup" : "Home delivery") · @Model.CreatedAt.ToString("MMM d, h:mm tt")
</p>

@if (Model.ScheduledFor != null)
{
    var sameDay = Model.ScheduledFor.Value.Date == Model.CreatedAt.Date;
    <div class="banner">
        @(sameDay ? (Model.OrderType == OrderType.Delivery ? "Preferred delivery time" : "Preferred pickup time") : "Needed on")
        <strong>@Model.ScheduledFor.Value.ToString(sameDay ? "h:mm tt" : "dddd, MMM d, h:mm tt")</strong>
    </div>
}

<div class="card status-card">
    <span class="chip chip-@Model.Status.ToString().ToLower()">@OrderText.Label(Model.Status)</span>
    <p class="status-msg">@OrderText.Message(Model)</p>
</div>

@* Module 7: once the order is on its way, the customer can reach the rider *@
@if (Model.OrderType == OrderType.Delivery && Model.Status == OrderStatus.OutForDelivery && !string.IsNullOrWhiteSpace(Model.RiderName))
{
    <div class="card rider-box" style="margin-top:0">
        <strong>Your rider: @Model.RiderName</strong>
        @if (!string.IsNullOrWhiteSpace(Model.RiderPhone))
        {
            <div class="rider-actions">
                <a class="btn btn-sm" href="tel:@Model.RiderPhone">Call @Model.RiderPhone</a>
                <a class="btn-ghost" href="sms:@Model.RiderPhone">Text</a>
            </div>
        }
    </div>
}

@if (Model.Status == OrderStatus.Completed)
{
    <partial name="_Survey" model="Model" />
}

@if (!string.IsNullOrWhiteSpace(Model.Notes))
{
    <div class="card">
        <strong>Your note</strong>
        <p class="muted order-note-text">@Model.Notes</p>
    </div>
}

<div class="card">
    <div class="steps">
        @for (int i = 0; i < steps.Count; i++)
        {
            <div class="step @(i <= currentIndex ? "done" : "")">
                <span class="dot"></span>
                @OrderText.Label(steps[i])
            </div>
        }
    </div>
</div>

@{
    var store = (StoreSettings)ViewBag.Store;
}
<div class="card pay-card">
    <div class="row">
        <strong>Payment</strong>
        <span class="chip @(Model.PaymentStatus == PaymentStatus.Paid ? "chip-ready" : Model.PaymentStatus is PaymentStatus.ProofSent or PaymentStatus.DepositPaid ? "chip-pending" : "chip-soldout")">@OrderText.PayStatusLabel(Model)</span>
    </div>
    <div class="muted">@OrderText.PayMethodLabel(Model) · ₱@Model.Total.ToString("N2")</div>
    @if (Model.DepositAmount != null)
    {
        <div class="muted">Deposit now: ₱@Model.DepositAmount.Value.ToString("N2") · Balance (at @(Model.OrderType == OrderType.Delivery ? "delivery" : "pickup")): ₱@((Model.Total - Model.DepositAmount.Value).ToString("N2"))</div>
    }

    @{
        var depositStillDue = Model.DepositAmount != null && Model.PaymentStatus is PaymentStatus.Unpaid or PaymentStatus.ProofSent;
        var showPayBox = Model.PaymentMethod == PaymentMethod.Cashless && Model.Status != OrderStatus.Cancelled &&
            (Model.DepositAmount == null ? Model.PaymentStatus != PaymentStatus.Paid : depositStillDue);
    }
    @if (showPayBox)
    {
        var amountDue = Model.DepositAmount ?? Model.Total;
        <div class="pay-box">
            <div class="pay-send">Send <strong>₱@amountDue.ToString("N2")</strong> to:</div>
            <partial name="_PayDetails" model="store" />

            @if (Model.PaymentStatus == PaymentStatus.ProofSent)
            {
                <p class="pay-ok">
                    We got your screenshot. Waiting for the carinderia to confirm.
                    <a href="/Payment/Proof/@Model.Id" target="_blank" rel="noopener">View my proof</a>
                </p>
            }

            <form asp-action="UploadProof" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                <label class="label" for="proof">@(Model.PaymentStatus == PaymentStatus.ProofSent ? "Send a new screenshot" : "Send your proof of payment")</label>
                <input class="input" id="proof" name="proof" type="file" accept="image/jpeg,image/png,image/webp" required />
                <label class="label" for="paymentRef">Reference number (optional)</label>
                <input class="input" id="paymentRef" name="paymentRef" maxlength="60" value="@Model.PaymentRef" />
                <button class="btn btn-sm" style="margin-top:12px">@(Model.PaymentStatus == PaymentStatus.ProofSent ? "Replace proof" : "Send proof")</button>
            </form>
        </div>
    }
</div>

<div class="card">
    @foreach (var item in Model.Items)
    {
        <div class="row">
            <span>
                @item.Quantity × @item.ItemName
                @if (item.TracksReadiness)
                {
                    <span class="chip chip-sm @(item.IsReadyToServe ? "chip-ready" : "chip-preparing")">@(item.IsReadyToServe ? "Ready" : "Preparing")</span>
                }
            </span>
            <span>₱@((item.UnitPrice * item.Quantity).ToString("N2"))</span>
        </div>
    }
    <hr class="divider" />
    @if (Model.DeliveryFee > 0)
    {
        <div class="row muted"><span>Delivery fee</span><span>₱@Model.DeliveryFee.ToString("N2")</span></div>
    }
    <div class="row total-row"><strong>Total</strong><strong>₱@Model.Total.ToString("N2")</strong></div>
</div>

<a class="link" asp-controller="Menu" asp-action="Index">Back to menu</a>

@section Scripts {
    <script>
        const current = '@Model.Status';
        if (current !== 'Completed' && current !== 'Cancelled') {
            setInterval(async () => {
                try {
                    const r = await fetch('@Url.Action("StatusJson", new { id = Model.Id })');
                    if (!r.ok) return;
                    const d = await r.json();
                    if (d.status !== current) location.reload();
                } catch (e) { }
            }, 8000);
        }
    </script>
}