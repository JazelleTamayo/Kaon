@model Order
@using Kaon.Helpers
@{
    ViewData["Title"] = "Order #" + Model.Id;
    var steps = OrderText.Steps(Model.OrderType);
    var currentIndex = steps.IndexOf(Model.Status);
}

<h1>Order #@Model.Id</h1>
<p class="muted">
    @(Model.OrderType == OrderType.Pickup ? "Pickup" : "Home delivery") · @Model.CreatedAt.ToString("MMM d, h:mm tt")
</p>

@if (Model.ScheduledFor != null)
{
    <div class="banner">Needed on <strong>@Model.ScheduledFor.Value.ToString("dddd, MMM d, h:mm tt")</strong></div>
}

<div class="card status-card">
    <span class="chip chip-@Model.Status.ToString().ToLower()">@OrderText.Label(Model.Status)</span>
    <p class="status-msg">@OrderText.Message(Model)</p>
</div>

<div class="card">
    <div class="steps">
        @for (int i = 0; i < steps.Count; i++)
        {
            <div class="step @(i <= currentIndex ? "done" : "")">
                <span class="dot"></span>
                @OrderText.Label(steps[i])
            </div>
        }
    </div>
</div>

<div class="card">
    @foreach (var item in Model.Items)
    {
        <div class="row">
            <span>@item.Quantity × @item.ItemName</span>
            <span>₱@((item.UnitPrice * item.Quantity).ToString("N2"))</span>
        </div>
    }
    <hr class="divider" />
    @if (Model.DeliveryFee > 0)
    {
        <div class="row muted"><span>Delivery fee</span><span>₱@Model.DeliveryFee.ToString("N2")</span></div>
    }
    <div class="row total-row"><strong>Total</strong><strong>₱@Model.Total.ToString("N2")</strong></div>
</div>

<a class="link" asp-controller="Menu" asp-action="Index">Back to menu</a>

@section Scripts {
    <script>
        const current = '@Model.Status';
        if (current !== 'Completed') {
            setInterval(async () => {
                try {
                    const r = await fetch('@Url.Action("StatusJson", new { id = Model.Id })');
                    if (!r.ok) return;
                    const d = await r.json();
                    if (d.status !== current) location.reload();
                } catch (e) { }
            }, 8000);
        }
    </script>
}