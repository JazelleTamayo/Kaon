@model CheckoutForm
@using Kaon.Helpers
@{
    ViewData["Title"] = "Checkout";
    var cart = (List<CartLine>)ViewBag.Cart;
    var fee = (decimal)ViewBag.DeliveryFee;
    var store = (StoreSettings)ViewBag.Store;
    var subtotal = cart.Sum(c => c.Price * c.Quantity);
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<h1>Checkout</h1>
@if (!store.IsOpen)
{
    <div class="banner banner-closed">We're closed right now. You can't place an order until we open.</div>
}

<form asp-action="Checkout" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="error"></div>

    <div class="card">
        <label class="label">How do you want your order?</label>
        <div class="choice">
            @if (store.PickupEnabled)
            {
                <label class="choice-opt">
                    <input type="radio" asp-for="OrderType" value="Pickup" />
                    <span>Pickup</span>
                </label>
            }
            @if (store.DeliveryEnabled)
            {
                <label class="choice-opt">
                    <input type="radio" asp-for="OrderType" value="Delivery" />
                    <span>Home delivery</span>
                </label>
            }
        </div>
    </div>

    <div class="card">
        <label class="label" asp-for="CustomerName">Your name</label>
        <input class="input" asp-for="CustomerName" autocomplete="name" />
        <span class="error" asp-validation-for="CustomerName"></span>

        <label class="label" asp-for="Phone">Phone number</label>
        <input class="input" asp-for="Phone" type="tel" inputmode="tel" autocomplete="tel" />
        <span class="error" asp-validation-for="Phone"></span>
    </div>

    @if ((bool)ViewBag.HasPackage)
    {
        <div class="card">
            <label class="label" asp-for="ScheduledFor">When do you need your food package?</label>
            <input class="input" asp-for="ScheduledFor" type="datetime-local"
                   min="@DateTime.Now.AddHours(24).ToString("yyyy-MM-ddTHH:mm")" />
            <span class="hint">Food packages and lechon are made ahead. Please give at least 1 day notice.</span>
            <span class="error" asp-validation-for="ScheduledFor"></span>
        </div>
    }
    else
    {
        <div class="card">
            <label class="label" asp-for="PreferredTime"><span id="timeLabel">Preferred pickup time</span> (optional)</label>
            <input class="input" asp-for="PreferredTime" type="time" step="300" />
            <span class="hint">Today. Leave it empty and we'll prepare it as soon as we can.</span>
            <span class="error" asp-validation-for="PreferredTime"></span>
        </div>
    }

    <div class="card" id="addressBox">
        <label class="label" asp-for="Address">Delivery address</label>
        <textarea class="input" asp-for="Address" rows="3"
                  placeholder="House no., street, barangay, landmark"></textarea>
        <span class="error" asp-validation-for="Address"></span>
        <label class="check">
            <input type="checkbox" asp-for="SaveAddress" />
            Save this address for my next order
        </label>
    </div>

    <div class="card">
        <label class="label" asp-for="Notes">Notes for the carinderia (optional)</label>
        <textarea class="input" asp-for="Notes" rows="2" maxlength="300"
                  placeholder="For example: less rice, extra sauce, blue gate"></textarea>
        <span class="error" asp-validation-for="Notes"></span>
    </div>

    @{ var cashlessOk = store.CashlessAvailable; }
    <div class="card">
        <label class="label">How will you pay?</label>
        <div class="pay-opts">
            @if (store.AcceptsCash)
            {
                <label class="pay-opt">
                    <input type="radio" asp-for="PaymentMethod" value="Cash" />
                    <span class="pay-tile">
                        <strong>Pay with cash</strong>
                        <small id="cashHint">Pay in person when you pick up your order.</small>
                    </span>
                </label>
            }
            @if (cashlessOk)
            {
                <label class="pay-opt">
                    <input type="radio" asp-for="PaymentMethod" value="Cashless" />
                    <span class="pay-tile">
                        <strong>Pay in advance</strong>
                        <small>GCash, bank or QR code. You send a screenshot as proof.</small>
                    </span>
                </label>
            }
        </div>

        @if (cashlessOk)
        {
            <div class="pay-box" id="cashlessBox" style="display:none">
                <div class="pay-send">Send <strong id="sendAmount"></strong> to:</div>
                <partial name="_PayDetails" model="store" />

                <label class="label" asp-for="Proof">Screenshot of your payment</label>
                <input class="input" asp-for="Proof" type="file" accept="image/jpeg,image/png,image/webp" />
                <span class="hint">You can also send it later from your order page. The carinderia confirms your payment.</span>
                <span class="error" asp-validation-for="Proof"></span>

                <label class="label" asp-for="PaymentRef">Reference number (optional)</label>
                <input class="input" asp-for="PaymentRef" maxlength="60" />
            </div>
        }
    </div>

    <div class="card">
        @foreach (var line in cart)
        {
            <div class="row">
                <span>@line.Quantity × @line.Name@(string.IsNullOrEmpty(line.OptionLabel) ? "" : " (" + line.OptionLabel + ")")</span>
                <span>₱@((line.Price * line.Quantity).ToString("N2"))</span>
            </div>
        }
        <hr class="divider" />
        <div class="row"><span>Subtotal</span><span>₱@subtotal.ToString("N2")</span></div>
        <div class="row" id="feeRow"><span>Delivery fee</span><span>₱@fee.ToString("N2")</span></div>
        <div class="row total-row"><strong>Total</strong><strong id="totalText"></strong></div>
    </div>

    <button class="btn">Place order</button>
    <a class="link" asp-controller="Cart" asp-action="Index">Back to cart</a>
</form>

@section Scripts {
    <script>
        const fee = @fee.ToString(inv);
        const subtotal = @subtotal.ToString(inv);
        const radios = document.querySelectorAll('input[name="OrderType"]');
        const addressBox = document.getElementById('addressBox');
        const feeRow = document.getElementById('feeRow');
        const totalText = document.getElementById('totalText');
        const sendAmount = document.getElementById('sendAmount');
        const cashHint = document.getElementById('cashHint');
        const cashlessBox = document.getElementById('cashlessBox');

        function money(n) {
            return '₱' + n.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function update() {
            const delivery = document.querySelector('input[name="OrderType"]:checked').value === 'Delivery';
            addressBox.style.display = delivery ? '' : 'none';
            const timeLabel = document.getElementById('timeLabel');
            if (timeLabel) timeLabel.textContent = delivery ? 'Preferred delivery time' : 'Preferred pickup time';
            feeRow.style.display = delivery ? '' : 'none';
            const total = subtotal + (delivery ? fee : 0);
            totalText.textContent = money(total);
            if (sendAmount) sendAmount.textContent = money(total);
            if (cashHint) cashHint.textContent = delivery
                ? 'Pay the rider in cash when your order is delivered.'
                : 'Pay in person when you pick up your order.';
        }

        radios.forEach(r => r.addEventListener('change', update));
        update();

        function payUpdate() {
            const c = document.querySelector('input[name="PaymentMethod"]:checked');
            if (cashlessBox) cashlessBox.style.display = (c && c.value === 'Cashless') ? '' : 'none';
        }
        document.querySelectorAll('input[name="PaymentMethod"]').forEach(r => r.addEventListener('change', payUpdate));
        payUpdate();

        document.querySelectorAll('[data-copy]').forEach(b => b.addEventListener('click', () => {
            if (navigator.clipboard) navigator.clipboard.writeText(b.dataset.copy);
            b.textContent = 'Copied';
        }));
    </script>
}