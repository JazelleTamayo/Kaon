@model CreateOwnerForm
@{
    ViewData["Title"] = "Add a carinderia owner";
}

<a class="back-link" asp-action="Index">&larr; Back to admin</a>
<h1>Add a carinderia owner</h1>
<p class="muted">Kaon creates the account with <strong>no password</strong>. You get a private link to send to the owner, and <strong>they choose their own password</strong>. You never see it.</p>

<form asp-action="CreateOwner" method="post">
    <div asp-validation-summary="ModelOnly" class="form-alert"></div>

    <div class="card">
        <label class="label" asp-for="FullName">Owner's full name</label>
        <input class="input" asp-for="FullName" autocomplete="off" />
        <span class="error" asp-validation-for="FullName"></span>

        <label class="label" asp-for="Email">Owner's email (they log in with this)</label>
        <input class="input" asp-for="Email" type="email" autocomplete="off" />
        <span class="error" asp-validation-for="Email"></span>

        <label class="label" asp-for="Phone">Mobile number (optional)</label>
        <input class="input" asp-for="Phone" type="tel" inputmode="tel" autocomplete="off" />
        <span class="error" asp-validation-for="Phone"></span>
    </div>

    <button class="btn">Create account and get the link</button>
    <a class="link" asp-action="Index">Cancel</a>
</form>
