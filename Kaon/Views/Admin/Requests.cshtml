@model List<CarinderiaRequest>
@{
    ViewData["Title"] = "Requests";
    ViewData["Wide"] = true;
    var all = (bool)ViewBag.All;
}

<section class="o-hero sm admin">
    <div class="o-hero-bg" aria-hidden="true"></div>
    <div class="o-hero-in">
        <span class="o-kicker">Requests</span>
        <h1>Carinderia requests</h1>
        <p>Carinderias that asked to join Kaon. Contact them, then create their account in one click.</p>
    </div>
</section>

<div class="filters" role="group" aria-label="Filter">
    <a class="fchip @(all ? "" : "on")" asp-action="Requests">Waiting</a>
    <a class="fchip @(all ? "on" : "")" asp-action="Requests" asp-route-all="true">All</a>
</div>

@if (!Model.Any())
{
    <div class="card"><p class="muted" style="margin:0">No requests @(all ? "yet" : "waiting").</p></div>
}
else
{
    <div class="card table-wrap">
        <table class="table table-stack">
            <thead><tr><th>Carinderia</th><th>Owner</th><th>Contact</th><th>Address</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td><strong>@r.CarinderiaName</strong><div class="muted">@r.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</div>
                            @if (!string.IsNullOrEmpty(r.Message)) { <div class="muted" style="font-size:.8rem">"@r.Message"</div> }</td>
                        <td data-label="Owner">@r.OwnerName</td>
                        <td data-label="Contact">@r.Phone<div class="muted">@r.Email</div></td>
                        <td data-label="Address">@r.Address</td>
                        <td data-label="Status"><span class="chip @(r.Status == "New" ? "chip-pending" : r.Status == "Approved" ? "chip-ready" : "chip-soldout")">@(r.Status == "New" ? "Waiting" : r.Status)</span></td>
                        <td class="actions">
                            @if (r.Status == "New")
                            {
                                <a class="btn btn-sm" asp-action="CreateOwner" asp-route-requestId="@r.Id">Create account</a>
                                <form asp-action="DeclineRequest" asp-route-id="@r.Id" method="post"><button class="btn-ghost danger">Decline</button></form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
