@model List<CarinderiaRequest>
@{
    ViewData["Title"] = "Requests";
    ViewData["Wide"] = true;
    var all = (bool)ViewBag.All;
    var owners = (Dictionary<string, AppUser>)ViewBag.Owners;
}

<section class="o-hero sm admin">
    <div class="o-hero-bg" aria-hidden="true"></div>
    <div class="o-hero-in">
        <span class="o-kicker">Requests</span>
        <h1>Carinderia requests</h1>
        <p>Carinderias that asked to join Kaon. Contact them, then create their account in one click.</p>
    </div>
</section>

<div class="filters" role="group" aria-label="Filter">
    <a class="fchip @(all ? "" : "on")" asp-action="Requests">Waiting</a>
    <a class="fchip @(all ? "on" : "")" asp-action="Requests" asp-route-all="true">All</a>
</div>

@if (!Model.Any())
{
    <div class="card"><p class="muted" style="margin:0">No requests @(all ? "yet" : "waiting").</p></div>
}
else
{
    <div class="card table-wrap">
        <table class="table table-stack">
            <thead><tr><th>Carinderia</th><th>Owner</th><th>Contact</th><th>Address</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td><strong>@r.CarinderiaName</strong><div class="muted">@r.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</div>
                            @if (!string.IsNullOrEmpty(r.Message)) { <div class="muted" style="font-size:.8rem">"@r.Message"</div> }</td>
                        <td data-label="Owner">@r.OwnerName</td>
                        <td data-label="Contact">@r.Phone<div class="muted">@r.Email</div></td>
                        <td data-label="Address">@r.Address</td>
                        @{ owners.TryGetValue(r.Email, out var made); }
                        <td data-label="Status">
                            @if (r.Status == "New") { <span class="chip chip-pending">Waiting for you</span> }
                            else if (r.Status == "Approved" && made != null && made.PasswordHash == "")
                            {
                                <span class="chip chip-pending">Approved</span>
                                <div class="muted" style="font-size:.75rem">Owner has not set a password yet</div>
                            }
                            else if (r.Status == "Approved") { <span class="chip chip-ready">Active</span> }
                            else { <span class="chip chip-soldout">@r.Status</span> }
                        </td>
                        <td class="actions">
                            @if (r.Status == "New")
                            {
                                <form asp-action="ApproveRequest" asp-route-id="@r.Id" method="post"
                                      onsubmit="return confirm('Approve @r.CarinderiaName.Replace("'", "") and send the invitation to @r.Email?');">
                                    <button class="btn btn-sm" style="margin:0">Approve and send invite</button>
                                </form>
                                <a class="btn-ghost" asp-action="CreateOwner" asp-route-requestId="@r.Id">Review first</a>
                                <form asp-action="DeclineRequest" asp-route-id="@r.Id" method="post"
                                      onsubmit="return confirm('Decline the request from @r.CarinderiaName.Replace("'", "")?');">
                                    <button class="btn-ghost danger">Decline</button>
                                </form>
                            }
                            else if (made?.StoreId != null)
                            {
                                <a class="btn-ghost" asp-action="Store" asp-route-id="@made.StoreId">Open carinderia</a>
                                @if (made.PasswordHash == "")
                                {
                                    <form asp-action="SendLink" asp-route-id="@made.Id" method="post"><button class="btn-ghost">New invite link</button></form>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
