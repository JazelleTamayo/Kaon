@model StoreDetailVm
@{
    ViewData["Title"] = Model.Store.Name;
    ViewData["Wide"] = true;
    var st = Model.Store;
    var stats = Model.Stats;
    var series = (string[])ViewBag.Series;
}

<a class="back-link" asp-action="Index">&larr; All carinderias</a>

<section class="o-hero sm admin">
    <div class="o-hero-bg" aria-hidden="true"></div>
    <div class="o-hero-in">
        <span class="o-kicker">Carinderia</span>
        <h1>@st.Name</h1>
        <p>Customer link: <a href="@Model.Link" style="color:#fff;text-decoration:underline">@Model.Link</a></p>
        <div class="o-hero-actions">
            @if (st.SuspendedByAdmin) { <span class="chip chip-cancelled">Paused by Kaon</span> }
            else { <span class="chip @(st.IsOpen ? "chip-ready" : "chip-soldout")">@(st.IsOpen ? "Open" : "Closed")</span> }
            <span class="chip @stats.PlanClass">@stats.Plan</span>
        </div>
    </div>
</section>

<div class="stats o-stats">
    <div class="stat c-orange">
        <span class="stat-ico"><svg viewBox="0 0 24 24"><path d="M4 12h16a8 8 0 0 1-16 0z"/><path d="M9 7c-1-1 1-2 0-3M14 7c-1-1 1-2 0-3"/></svg></span>
        <span class="stat-num">@stats.Dishes</span><span class="stat-label">Dishes and packages</span>
    </div>
    <div class="stat c-yellow">
        <span class="stat-ico"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
        <span class="stat-num">@(stats.AccessUntil == null ? "-" : stats.DaysLeft.ToString())</span><span class="stat-label">Days of access left</span>
    </div>
    <div class="stat c-green">
        <span class="stat-ico"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span>
        <span class="stat-num">@Model.Owners.Count</span><span class="stat-label">Owner@(Model.Owners.Count == 1 ? "" : "s")</span>
    </div>
</div>

<h2 class="section">QR code and printables</h2>
<div class="card">
    <div class="scan-nums">
        <div><strong>@Model.Qr.Today</strong><span>Scans today</span></div>
        <div><strong>@Model.Qr.Last30Days</strong><span>Last 30 days</span></div>
        <div><strong>@Model.Qr.Total</strong><span>All time</span></div>
        <div><strong>@Model.Qr.SignUps</strong><span>Sign-ups after scanning</span></div>
    </div>
    @if (Model.Qr.BySource.Any())
    {
        <ul class="scan-sources">
            @foreach (var (source, count) in Model.Qr.BySource) { <li><span>@source</span><strong>@count</strong></li> }
        </ul>
    }
    <div class="share-actions">
        @foreach (var p in QrSources.Printables)
        {
            <a class="btn btn-sm btn-outline" href="@Url.Action("StorePrint", new { id = st.Id, kind = p.Key })" target="_blank" rel="noopener">@p.Name</a>
        }
        <a class="btn btn-sm btn-outline" href="@Url.Action("StoreQr", new { id = st.Id, download = true })">Download QR (PNG)</a>
    </div>
    <p class="muted" style="margin:10px 0 0;font-size:.85rem">Pilot target: 10 to 15 customers scanning and signing up for each carinderia.</p>
</div>

<h2 class="section">Feedback</h2>
@{ var fbk = Model.Feedback; }
<div class="card">
    <div class="scan-nums">
        <div><strong>@(fbk.AverageRating == null ? "-" : fbk.AverageRating.Value.ToString("0.0"))</strong><span>Average rating (@fbk.Responses answer@(fbk.Responses == 1 ? "" : "s"))</span></div>
        <div><strong>@(fbk.FeeYesPercent == null ? "-" : Math.Round(fbk.FeeYesPercent.Value) + "%")</strong><span>Delivery fee fair (@fbk.FeeAnswers answer@(fbk.FeeAnswers == 1 ? "" : "s"))</span></div>
        <div><strong>@(fbk.AverageMinutesSaved == null ? "-" : "~" + Math.Round(fbk.AverageMinutesSaved.Value) + " min")</strong><span>Waiting time saved</span></div>
        <div><strong>@(fbk.SeparationRating == null ? "-" : fbk.SeparationRating + " / 5")</strong><span>Owner: pickup and delivery apart helps</span></div>
    </div>
    <ul class="scan-sources">
        <li><span>Orders that went wrong, a week before Kaon (owner's guess)</span><strong>@(fbk.ProblemsPerWeekBefore?.ToString() ?? "-")</strong></li>
        <li><span>Orders that went wrong, a week now (last 4 weeks)</span><strong>@fbk.ProblemsPerWeekLast4Weeks.ToString("0.#")</strong></li>
        @foreach (var (kind, count) in fbk.ProblemKindsLast30Days) { <li><span>@kind (last 30 days)</span><strong>@count</strong></li> }
    </ul>
    <p class="muted" style="margin:10px 0 0;font-size:.85rem">Pilot target: at least @FeedbackStats.FeeTargetPercent% say the delivery fee is fair. Comments stay with the owner.</p>
</div>

<h2 class="section">Plan</h2>
<div class="card" style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center">
    <div>
        @if (stats.AccessUntil == null)
        {
            <strong>No plan yet.</strong> <span class="muted">Add an owner first.</span>
        }
        else
        {
            <strong>@stats.Plan</strong>
            <span class="muted"> · access until @stats.AccessUntil.Value.ToLocalTime().ToString("MMM d, yyyy") (@stats.DaysLeft day@(stats.DaysLeft == 1 ? "" : "s") left)</span>
        }
    </div>
    <a class="btn btn-sm btn-outline" asp-controller="AdminBilling" asp-action="Index">Open billing</a>
</div>

<h2 class="section">Owners</h2>
<div class="card">
    @if (!Model.Owners.Any())
    {
        <p class="muted" style="margin:0 0 12px">No owner yet.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table-stack">
                <thead><tr><th>Owner</th><th>Email</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var u in Model.Owners)
                    {
                        <tr>
                            <td><strong>@u.FullName</strong>@if (!string.IsNullOrEmpty(u.Phone)) { <div class="muted">@u.Phone</div> }</td>
                            <td data-label="Email">@u.Email</td>
                            <td data-label="Status">
                                @if (!u.IsActive) { <span class="chip chip-soldout">Switched off</span> }
                                else if (u.PasswordHash == "")
                                {
                                    <span class="chip chip-pending">Invite pending</span>
                                    @if (Model.PendingLinks.TryGetValue(u.Id, out var until))
                                    {
                                        <div class="muted" style="font-size:.75rem">Link valid until @until.ToLocalTime().ToString("MMM d, h:mm tt")</div>
                                    }
                                    else { <div class="muted" style="font-size:.75rem">Link expired. Send a new one.</div> }
                                }
                                else { <span class="chip chip-ready">Active</span> }
                            </td>
                            <td class="actions">
                                <form asp-action="SendLink" asp-route-id="@u.Id" method="post">
                                    <button class="btn-ghost">@(u.PasswordHash == "" ? "New invite link" : "Send reset link")</button>
                                </form>
                                <form asp-action="ToggleActive" asp-route-id="@u.Id" method="post">
                                    <button class="btn-ghost @(u.IsActive ? "danger" : "")">@(u.IsActive ? "Switch off" : "Switch on")</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <a class="btn btn-sm" asp-action="CreateOwner" asp-route-storeId="@st.Id">+ Add another owner</a>
</div>

<h2 class="section">Set up the menu for the owner</h2>
<div class="card">
    <p class="muted" style="margin-top:0">Help the owner start on day one. They can change names, prices and photos later.</p>
    @if (stats.Dishes == 0)
    {
        <form asp-action="AddStarterMenu" asp-route-id="@st.Id" method="post" style="margin-bottom:16px">
            <button class="btn btn-sm">Add the sample starter menu</button>
            <span class="muted"> Adds sample dishes and food packages, and puts the dishes on today's menu.</span>
        </form>
    }
    <form asp-action="AddDish" asp-route-id="@st.Id" method="post" class="form-row" style="--cols:2fr 1fr 1fr auto">
        <div>
            <label class="label" for="dishName">Dish name</label>
            <input class="input" id="dishName" name="Name" maxlength="100" required />
        </div>
        <div>
            <label class="label" for="dishPrice">Price (₱)</label>
            <input class="input" id="dishPrice" name="Price" type="number" min="1" step="1" inputmode="numeric" required />
        </div>
        <div>
            <label class="label" for="dishSeries">Series</label>
            <select class="input" id="dishSeries" name="Series">
                @foreach (var sName in series) { <option value="@sName">@sName</option> }
            </select>
        </div>
        <button class="btn btn-sm">Add dish</button>
    </form>
</div>

<div class="grid-2">
<div>
<h2 class="section">Name and web address</h2>
<div class="card">
    <form asp-action="RenameStore" asp-route-id="@st.Id" method="post" class="form-row">
        <div>
            <label class="label" for="storeName">Carinderia name</label>
            <input class="input" id="storeName" name="Name" value="@st.Name" maxlength="100" required />
        </div>
        <div>
            <label class="label" for="storeSlug">Web address (/c/...)</label>
            <input class="input" id="storeSlug" name="Slug" value="@st.Slug" maxlength="60" required />
        </div>
        <button class="btn btn-sm">Save</button>
    </form>
    <p class="muted" style="margin:10px 0 0;font-size:.85rem">Changing the web address breaks any QR code already printed. Change the name freely.</p>
</div>

</div>
<div>
<h2 class="section">Pause this carinderia</h2>
<div class="card" style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center">
    <p class="muted" style="margin:0;max-width:640px">
        @if (st.SuspendedByAdmin)
        {
            <text>This carinderia is paused. Customers see "isn't taking orders right now". The owner can still log in.</text>
        }
        else
        {
            <text>Stops new orders at this carinderia, for example for an unpaid account or on the owner's request. The owner can still log in, and customers keep their existing orders.</text>
        }
    </p>
    <form asp-action="ToggleSuspend" asp-route-id="@st.Id" method="post">
        <button class="btn btn-sm @(st.SuspendedByAdmin ? "" : "btn-outline")">@(st.SuspendedByAdmin ? "Resume" : "Pause this carinderia")</button>
    </form>
</div>

</div>
</div>

<p class="muted" style="margin-top:24px;font-size:.85rem">Customers and orders belong to the carinderia. The Kaon team does not see customer names, contacts, addresses, orders or payment proofs, and does not see how many there are.</p>

<h2 class="section">Recent activity</h2>
<div class="card table-wrap">
    @if (!Model.Activity.Any())
    {
        <p class="muted" style="margin:0">Nothing yet.</p>
    }
    else
    {
        <table class="table table-stack">
            <thead><tr><th>When</th><th>Who</th><th>What</th></tr></thead>
            <tbody>
                @foreach (var a in Model.Activity)
                {
                    <tr>
                        <td>@a.At.ToLocalTime().ToString("MMM d, h:mm tt")</td>
                        <td data-label="Who">@a.AdminName</td>
                        <td data-label="What">@a.Action</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <p style="margin:12px 0 0"><a asp-action="Activity" asp-route-storeId="@st.Id">See all activity for this carinderia</a></p>
</div>
