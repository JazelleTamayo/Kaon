@model AdminDashVm
@{
    ViewData["Title"] = "Kaon admin";
    ViewData["Wide"] = true;
    var unassigned = Model.Owners.Where(o => o.StoreId == null || !Model.Stores.Any(x => x.Id == o.StoreId)).ToList();
}

<section class="ob-hero no-print">
    <div class="o-hero-bg" aria-hidden="true"></div>
    <header class="ob-bar">
        <div class="ob-id">
            <h1>Carinderias</h1>
            <span class="ob-sub">Owners sign up on their own and appear here</span>
        </div>
        <div class="ob-actions">
            <a class="btn btn-sm btn-yellow" style="margin:0" asp-action="CreateOwner">+ Add a carinderia</a>
        </div>
    </header>
</section>

<div class="ob-stats" role="group" aria-label="Carinderias at a glance">
    <div class="ob-stat"><span class="n">@Model.Stores.Count</span><span class="l">Carinderias</span></div>
    <div class="ob-stat"><span class="n">@Model.TrialCount</span><span class="l">On free trial</span></div>
    <div class="ob-stat"><span class="n">@Model.PayingCount</span><span class="l">Paying</span></div>
    <div class="ob-stat @(Model.EndedCount > 0 ? "is-alert" : "")"><span class="n">@Model.EndedCount</span><span class="l">Plan ended</span></div>
</div>

@if (!Model.Stores.Any())
{
    <div class="card"><p class="muted" style="margin:0">No carinderias yet. Add the first one.</p></div>
}
else
{
    <div class="card table-wrap adm-list">
        <table class="table table-stack">
            <thead><tr><th>Carinderia</th><th>Owner</th><th>Store</th><th>Plan</th><th></th></tr></thead>
            <tbody>
                @foreach (var st in Model.Stores)
                {
                    var owners = Model.Owners.Where(o => o.StoreId == st.Id).ToList();
                    var stat = Model.Stats.TryGetValue(st.Id, out var sv) ? sv : new StoreStats();
                    <tr>
                        <td><a class="adm-name" asp-action="Store" asp-route-id="@st.Id">@st.Name</a></td>
                        <td data-label="Owner">
                            @if (!owners.Any()) { <span class="muted">No owner yet</span> }
                            @foreach (var u in owners)
                            {
                                <div>
                                    <strong>@u.FullName</strong>
                                    @if (!u.IsActive) { <span class="chip chip-soldout">Switched off</span> }
                                    else if (u.PasswordHash == "") { <span class="chip chip-pending">Invite pending</span> }
                                    <div class="muted">@u.Email</div>
                                </div>
                            }
                        </td>
                        <td data-label="Store">
                            @if (st.SuspendedByAdmin) { <span class="chip chip-cancelled">Paused by Kaon</span> }
                            else { <span class="chip @(st.IsOpen ? "chip-ready" : "chip-soldout")">@(st.IsOpen ? "Open" : "Closed")</span> }
                        </td>
                        <td data-label="Plan">
                            <span class="chip @stat.PlanClass">@stat.Plan</span>
                            @if (stat.AccessUntil != null && stat.Plan != "Ended" && stat.Plan != "Paused by Kaon") { <div class="muted">@stat.DaysLeft days left</div> }
                        </td>
                        <td class="actions"><a class="btn btn-sm btn-outline" style="margin:0" asp-action="Store" asp-route-id="@st.Id">Manage</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (unassigned.Any())
{
    <h2 class="section">Owners with no carinderia</h2>
    <div class="card table-wrap">
        <table class="table table-stack">
            <thead><tr><th>Owner</th><th>Email</th></tr></thead>
            <tbody>
                @foreach (var u in unassigned)
                {
                    <tr><td><strong>@u.FullName</strong></td><td data-label="Email">@u.Email</td></tr>
                }
            </tbody>
        </table>
    </div>
}

<p class="muted" style="font-size:.85rem">Each carinderia is separate. Customers reach one only through its own link or QR code.</p>
