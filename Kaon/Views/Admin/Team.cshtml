@model List<AppUser>
@{
    ViewData["Title"] = "Kaon team";
    ViewData["Wide"] = true;
    var myId = (int)ViewBag.MyId;
    var pending = (Dictionary<int, DateTime>)ViewBag.PendingLinks;
}

<section class="o-hero sm admin">
    <div class="o-hero-bg" aria-hidden="true"></div>
    <div class="o-hero-in">
        <span class="o-kicker">Kaon team</span>
        <h1>People who run Kaon</h1>
        <p>Everyone here can use this admin area. Each person chooses their own password from a private link.</p>
        <div class="o-hero-actions">
            <a class="btn btn-sm btn-yellow" asp-action="AddAdmin">+ Add a team member</a>
        </div>
    </div>
</section>

<div style="height:16px"></div>
<div class="card table-wrap">
    <table class="table table-stack">
        <thead><tr><th>Name</th><th>Email</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td><strong>@u.FullName</strong>@if (u.Id == myId) { <span class="muted"> (you)</span> }</td>
                    <td data-label="Email">@u.Email</td>
                    <td data-label="Status">
                        @if (!u.IsActive) { <span class="chip chip-soldout">Switched off</span> }
                        else if (u.PasswordHash == "")
                        {
                            <span class="chip chip-pending">Invite pending</span>
                            @if (pending.TryGetValue(u.Id, out var until))
                            {
                                <div class="muted" style="font-size:.75rem">Link valid until @until.ToLocalTime().ToString("MMM d, h:mm tt")</div>
                            }
                            else { <div class="muted" style="font-size:.75rem">Link expired. Send a new one.</div> }
                        }
                        else { <span class="chip chip-ready">Active</span> }
                    </td>
                    <td class="actions">
                        @if (u.Id != myId)
                        {
                            <form asp-action="SendLink" asp-route-id="@u.Id" method="post">
                                <button class="btn-ghost">@(u.PasswordHash == "" ? "New invite link" : "Send reset link")</button>
                            </form>
                            <form asp-action="ToggleActive" asp-route-id="@u.Id" asp-route-back="team" method="post">
                                <button class="btn-ghost @(u.IsActive ? "danger" : "")">@(u.IsActive ? "Switch off" : "Switch on")</button>
                            </form>
                        }
                        else
                        {
                            <span class="muted">This is you</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
