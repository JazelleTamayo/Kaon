@model List<Kaon.Helpers.CartLine>
@{
    ViewData["Title"] = "Your cart";
    ViewData["Wide"] = true;
    var fee = (decimal)ViewBag.DeliveryFee;
    var meals = Model.Where(c => !c.IsPackage).ToList();
    // Each distinct date the customer picked is its own box; it becomes its own order at checkout.
    var boxes = Model.Where(c => c.IsPackage).GroupBy(c => c.ScheduledFor!.Value).OrderBy(g => g.Key).ToList();
}

<h1 style="margin-bottom:4px">Your cart</h1>

@if (!Model.Any())
{
    <div class="card cart-empty">
        <p>Your cart is empty.</p>
        <a class="btn" asp-controller="Menu" asp-action="Index" style="margin:0">View menu</a>
    </div>
}
else
{
    <div class="cart-layout">
        <div class="cart-main">
            @if (meals.Any())
            {
                <h2 class="section">Today's order</h2>
                <div class="card cart-card">
                    @foreach (var line in meals) { <partial name="_CartLine" model="line" /> }
                </div>
            }

            @foreach (var box in boxes)
            {
                <h2 class="section">Food package · needed @box.Key.ToString("MMM d, h:mm tt")</h2>
                <div class="card cart-card">
                    @foreach (var line in box) { <partial name="_CartLine" model="line" /> }
                </div>
            }

            <a class="link" asp-controller="Menu" asp-action="Index">+ Add more items</a>
        </div>

        <aside class="cart-side">
            @if (meals.Any())
            {
                var mealSubtotal = meals.Sum(c => c.Price * c.Quantity);
                <div class="card cart-sum">
                    <h2>Today's order</h2>
                    <div class="row"><span>@meals.Sum(c => c.Quantity) item@(meals.Sum(c => c.Quantity) == 1 ? "" : "s")</span><strong>₱@mealSubtotal.ToString("N2")</strong></div>
                    <div class="row muted"><span>Delivery fee, only if you choose delivery</span><span>₱@fee.ToString("N2")</span></div>
                    <div class="row cs-total"><span>Subtotal</span><strong>₱@mealSubtotal.ToString("N2")</strong></div>
                    <a class="btn" asp-controller="Order" asp-action="Checkout" asp-route-group="meal">Checkout today's order</a>
                </div>
            }

            @foreach (var box in boxes)
            {
                var boxSubtotal = box.Sum(c => c.Price * c.Quantity);
                var boxKey = box.Key.ToString("yyyy-MM-ddTHH:mm");
                <div class="card cart-sum">
                    <h2>Package for @box.Key.ToString("MMM d")</h2>
                    <div class="row"><span>Needed by</span><strong>@box.Key.ToString("h:mm tt")</strong></div>
                    <div class="row"><span>Subtotal</span><strong>₱@boxSubtotal.ToString("N2")</strong></div>
                    <div class="row cs-total"><span>Deposit due now (50%)</span><strong>₱@((boxSubtotal * 0.5m).ToString("N2"))</strong></div>
                    <div class="row muted"><span>Balance at pickup or delivery</span><span>₱@((boxSubtotal * 0.5m).ToString("N2"))</span></div>
                    <a class="btn" asp-controller="Order" asp-action="Checkout" asp-route-group="package" asp-route-groupKey="@boxKey">Checkout this package</a>
                </div>
            }
        </aside>
    </div>
}
