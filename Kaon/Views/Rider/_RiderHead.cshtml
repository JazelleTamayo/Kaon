<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex, nofollow" />
<meta name="referrer" content="no-referrer" />
<meta name="theme-color" content="#E8501F" />
<link rel="icon" type="image/svg+xml" href="~/img/logo-icon.svg" />
<style>
    :root { --orange: #E8501F; --dark: #2A1A12; --cream: #FFF4E3; --muted: #6b5a4e; --green: #2E8B57; --line: #f1dcc0; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif; color: var(--dark); background: var(--cream); font-size: 17px; line-height: 1.45; }
    header { background: var(--orange); color: #fff; padding: 14px 16px; }
    header .brand { font-weight: 800; letter-spacing: -.02em; opacity: .9; font-size: .9rem; }
    header h1 { margin: 2px 0 0; font-size: 1.35rem; }
    main { max-width: 560px; margin: 0 auto; padding: 16px; }
    .card { background: #fff; border-radius: 18px; padding: 16px; margin-bottom: 14px; box-shadow: 0 4px 18px rgba(43,24,16,.07); }
    .label { font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
    .big { font-size: 1.25rem; font-weight: 700; }
    .addr { font-size: 1.2rem; font-weight: 700; }
    .muted { color: var(--muted); font-size: .9rem; }
    .row { display: flex; justify-content: space-between; gap: 10px; }
    .items { list-style: none; margin: 0; padding: 0; }
    .items li { display: flex; justify-content: space-between; gap: 10px; padding: 6px 0; border-bottom: 1px dashed var(--line); }
    .items li:last-child { border-bottom: 0; }
    .note { background: #fff7df; border-left: 4px solid #F6B42C; padding: 8px 10px; border-radius: 8px; margin-top: 10px; font-weight: 600; }
    .collect { text-align: center; border: 3px dashed var(--dark); border-radius: 14px; padding: 12px; }
    .collect strong { display: block; font-size: 2rem; line-height: 1.1; }
    .collect.paid { border-color: var(--green); color: var(--green); }
    .btn { display: block; width: 100%; min-height: 56px; border: 0; border-radius: 999px; font: inherit; font-size: 1.1rem; font-weight: 700; cursor: pointer; text-align: center; text-decoration: none; padding: 14px; }
    .btn-main { background: var(--orange); color: #fff; }
    .btn-done { background: var(--green); color: #fff; }
    .btn-line { background: #fff; color: var(--dark); border: 2px solid var(--line); }
    .btn:focus-visible { outline: 3px solid #F6B42C; outline-offset: 2px; }
    .actions { display: grid; gap: 10px; }
    .call { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 12px; }
    .check { display: flex; gap: 12px; align-items: flex-start; font-weight: 600; margin-bottom: 12px; }
    .check input { width: 26px; height: 26px; margin: 0; flex: none; accent-color: var(--green); }
    .warn { background: #fde2df; color: #b3261e; border-radius: 12px; padding: 10px 12px; margin-bottom: 14px; font-weight: 600; }
    .status { display: inline-block; padding: 4px 12px; border-radius: 999px; font-size: .8rem; font-weight: 700; background: #fde9cc; color: var(--orange); }
    .status.done { background: #dff1e6; color: var(--green); }
    .center { text-align: center; }
</style>
