@{
    Layout = "_Landing";
    ViewData["Title"] = "Kaon";
    var plan = (PlatformSettings)ViewBag.Plan;
}


<partial name="_PublicNav" />

<main>
    <!-- Hero -->
    <section id="top" class="hero">
        <div class="wrap hero-grid">
            <div class="hero-copy">
                <span class="eyebrow">For local carinderia owners</span>
                <h1>Your carinderia.<br /><span class="hl">Your own customers.</span></h1>
                <p class="lead">
                    Kaon gives you your own page, link and QR code, and one simple dashboard for every
                    order. Customers order ahead from you, not from a marketplace.
                </p>
                <div class="cta-row">
                    <a class="lp-btn lp-btn-lg" asp-controller="Apply" asp-action="Index">Get Kaon for your carinderia</a>
                </div>
                <ul class="hero-points">
                    <li><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg> 30 days free</li>
                    <li><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg> No commissions</li>
                </ul>
                <p class="muted" style="margin-top:.75rem;font-size:.9rem">Customer? Open your carinderia's own link or scan its QR code to order.</p>
            </div>

            <div class="hero-art" aria-hidden="true">
                <div class="photo-wrap"><div class="photo" role="img" aria-label="Trays of home-cooked viands at a carinderia counter"></div></div>
                <div class="phone">
                    <div class="phone-top"><span class="dotbar"></span></div>
                    <div class="ph-title">Order #210 <span class="chip c-prep">Preparing</span></div>
                    <div class="ph-steps">
                        <span class="done"></span><span class="now"></span><span></span><span></span>
                    </div>
                    <div class="ph-labels"><span>Pending</span><span>Preparing</span><span>Ready</span><span>On the way</span></div>
                    <div class="ph-item"><span>1 × Chicken Adobo</span><b>₱70</b></div>
                    <div class="ph-item"><span>1 × Pork Sinigang</span><b>₱80</b></div>
                    <div class="ph-item muted"><span>Delivery fee</span><b>₱30</b></div>
                    <div class="ph-total"><span>Total</span><b>₱180</b></div>
                    <div class="ph-msg">Your order is being prepared.</div>
                </div>
                <div class="float f1"><span class="chip c-ready">Ready</span> Order #214</div>
                <div class="float f2"><span class="chip c-del">Out for Delivery</span></div>
            </div>
        </div>
    </section>

    <!-- How it works -->
    <section id="how" class="sec">
        <div class="wrap">
            <span class="eyebrow">How it works</span>
            <h2>Get your carinderia online in three steps</h2>
            <div class="steps3">
                <article class="step3">
                    <div class="ico"><svg viewBox="0 0 24 24"><rect x="7" y="2.5" width="10" height="19" rx="3"/><path d="M11 18h2"/></svg></div>
                    <h3>1. Request your account</h3>
                    <p>Send a short request. The Kaon team sets up your carinderia and sends you a private link to choose your own password.</p>
                </article>
                <article class="step3">
                    <div class="ico"><svg viewBox="0 0 24 24"><rect x="4" y="8" width="16" height="12" rx="3"/><path d="M8 8a4 4 0 0 1 8 0"/></svg></div>
                    <h3>2. Set up your menu</h3>
                    <p>Add your store details, post today's dishes and food packages, and choose how you get paid.</p>
                </article>
                <article class="step3">
                    <div class="ico"><svg viewBox="0 0 24 24"><path d="M6 17V11a6 6 0 0 1 12 0v6l2 2H4z"/><path d="M10 21h4"/></svg></div>
                    <h3>3. Share your link and QR</h3>
                    <p>Post your own link on Facebook or Messenger and print the QR at your counter. Customers order ahead and you see every order in one list.</p>
                </article>
            </div>
            <div class="status-strip" aria-label="Order status">
                <span class="chip c-pend">Pending</span><i></i>
                <span class="chip c-prep">Preparing</span><i></i>
                <span class="chip c-ready">Ready</span><i></i>
                <span class="chip c-del">Out for Delivery</span>
            </div>
        </div>
    </section>

    <!-- Sample daily menu -->
    <section id="preview" class="menu-sec">
        <div class="wrap">
            <div class="menu-head">
                <div>
                    <span class="eyebrow">What your customers see</span>
                    <h2>Your daily menu, posted by you</h2>
                </div>
                <p class="menu-note">Sample menu. Each carinderia posts its own meals and food packages every day.</p>
            </div>
            <div class="menu-row">
                <article class="dish">
                    <div class="dish-ico"><svg viewBox="0 0 24 24"><path d="M4 12h16a8 8 0 0 1-16 0z"/><path d="M9 7c-1-1 1-2 0-3M14 7c-1-1 1-2 0-3"/></svg></div>
                    <h3>Chicken Adobo</h3><p>With rice</p>
                    <div class="dish-foot"><b>₱70</b><span class="chip c-ready">Available</span></div>
                </article>
                <article class="dish">
                    <div class="dish-ico"><svg viewBox="0 0 24 24"><path d="M4 12h16a8 8 0 0 1-16 0z"/><path d="M9 7c-1-1 1-2 0-3M14 7c-1-1 1-2 0-3"/></svg></div>
                    <h3>Pork Sinigang</h3><p>Sour soup, with rice</p>
                    <div class="dish-foot"><b>₱80</b><span class="chip c-ready">Available</span></div>
                </article>
                <article class="dish">
                    <div class="dish-ico"><svg viewBox="0 0 24 24"><path d="M4 12h16a8 8 0 0 1-16 0z"/><path d="M9 7c-1-1 1-2 0-3M14 7c-1-1 1-2 0-3"/></svg></div>
                    <h3>Pancit Canton</h3><p>Stir-fried noodles</p>
                    <div class="dish-foot"><b>₱60</b><span class="chip c-ready">Available</span></div>
                </article>
                <article class="dish">
                    <div class="dish-ico"><svg viewBox="0 0 24 24"><rect x="4" y="8" width="16" height="12" rx="3"/><path d="M8 8a4 4 0 0 1 8 0"/></svg></div>
                    <h3>Family Food Package</h3><p>3 viands + 4 rice</p>
                    <div class="dish-foot"><b>₱350</b><span class="chip c-pend">Only 4 left</span></div>
                </article>
            </div>
        </div>
    </section>

    <!-- For owners -->
    <section id="owners" class="sec sec-owner">
        <div class="wrap owner-grid">
            <div>
                <span class="eyebrow eyebrow-light">For carinderia owners</span>
                <h2>Every order in one list.</h2>
                <p class="lead-light">
                    Stop juggling paper notes, verbal orders and Messenger threads. Pickup and delivery
                    are kept apart, so nothing gets missed.
                </p>
                <ul class="checks">
                    <li>Post the day's menu and set how many portions you have. Sold out is automatic.</li>
                    <li>Move each order from Pending to Ready with one tap. Customers see it right away.</li>
                    <li>See your sales and top sellers in an end-of-day summary.</li>
                </ul>
            </div>
            <div class="board-art" aria-hidden="true">
                <div class="mini-col"><b>Pending</b>
                    <div class="mini-card"><span>#210</span><em>Pickup</em></div>
                    <div class="mini-card"><span>#211</span><em class="t">Delivery</em></div>
                </div>
                <div class="mini-col"><b>Preparing</b>
                    <div class="mini-card"><span>#212</span><em>Pickup</em></div>
                </div>
                <div class="mini-col"><b>Ready</b>
                    <div class="mini-card"><span>#214</span><em>Pickup</em></div>
                    <div class="mini-card"><span>#216</span><em class="t">Delivery</em></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="sec">
        <div class="wrap">
            <span class="eyebrow">Pricing</span>
            <h2>One simple monthly fee. No commissions.</h2>
            <div class="price-grid">
                <article class="price-card">
                    <div class="price-tag">Start free</div>
                    <div class="price-big">@plan.TrialDays days <small>free</small></div>
                    <p>Try Kaon with your own customers first. You pay nothing to request your account.</p>
                </article>
                <article class="price-card price-main">
                    <div class="price-tag">Then</div>
                    <div class="price-big">₱@plan.MonthlyFee.ToString("N0") <small>/ month</small></div>
                    <p>A low, fixed fee for your carinderia. No percentage of your sales, and no per-order charge.</p>
                </article>
                <article class="price-card">
                    <div class="price-tag">Delivery</div>
                    <div class="price-big">Paid by the customer</div>
                    <p>A small, fixed delivery fee is added to delivery orders. It is kept separate from your subscription.</p>
                </article>
            </div>
            <div class="bill-steps">
                <h3>How billing works</h3>
                <ol>
                    <li><b>Request your account.</b> No payment is needed.</li>
                    <li><b>Your first @plan.TrialDays days are free,</b> starting when your account is created.</li>
                    <li><b>We remind you</b> in your dashboard before the free month ends.</li>
                    <li><b>Pay by GCash</b> and upload your proof. The Kaon team confirms it and your plan is extended.</li>
                </ol>
                <p class="muted">If a plan lapses, you can still log in to pay. Orders and menu tools unlock again once your payment is confirmed.</p>
            </div>
        </div>
    </section>

</main>

<footer class="lp-foot">
    <div class="wrap foot-in">
        <a class="lp-brand" href="/" aria-label="Kaon home"><partial name="_Mark" /><span>kaon</span></a>
        <span>Order ahead. Skip the line.</span>
        <span>Team Kaon · IT-FRELEAN · 2026 · <a asp-controller="Home" asp-action="Privacy">Privacy Notice</a></span>
    </div>
</footer>

<script>
    // Highlight the nav link of the section you are looking at
    (function () {
        var map = [
            ['top', 'top'], ['how', 'how'], ['preview', 'preview'], ['owners', 'owners'], ['pricing', 'pricing']
        ];
        var links = {};
        document.querySelectorAll('.lp-links a[data-spy]').forEach(function (a) { links[a.dataset.spy] = a; });
        function update() {
            var line = window.innerHeight * 0.35, current = 'top';
            map.forEach(function (m) {
                var el = document.getElementById(m[0]);
                if (el && el.getBoundingClientRect().top <= line) current = m[1];
            });
            Object.keys(links).forEach(function (k) { links[k].classList.toggle('is-active', k === current); });
        }
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
    })();

    // Scroll reveal. Content stays visible if this script does not run.
    (function () {
        document.documentElement.classList.add('js');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var groups = ['.steps3 > *', '.menu-row > *', '.status-strip', '.checks li', '.board-art', '.sec h2', '.menu-head'];
        var els = [];
        groups.forEach(function (sel) {
            document.querySelectorAll(sel).forEach(function (el, i) {
                el.classList.add('reveal');
                el.style.transitionDelay = (i * 90) + 'ms';
                els.push(el);
            });
        });
        if (reduce || !('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('in'); }); return; }
        var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
                if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
            });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
        els.forEach(function (e) { io.observe(e); });
    })();
</script>
