@model List<StoreSettings>
@{
    ViewData["Title"] = "My carinderias";
    var currentId = (int?)ViewBag.CurrentId;
}

<h1>My carinderias</h1>
<p class="muted">The carinderias you joined with their link or QR code. To join another one, open its link or scan its QR code.</p>

<div class="card">
    @foreach (var s in Model)
    {
        <form asp-action="Switch" method="post" style="display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.6rem 0;border-bottom:1px solid var(--line, #eee)">
            <div>
                <strong>@s.Name</strong>
                @if (s.Id == currentId) { <span class="muted"> · ordering from here now</span> }
            </div>
            <input type="hidden" name="storeId" value="@s.Id" />
            @if (s.Id != currentId) { <button class="btn btn-sm">Order here</button> }
        </form>
    }
</div>
