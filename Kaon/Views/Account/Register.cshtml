@model RegisterForm
@{
    Layout = "_Auth";
    ViewData["Title"] = "Sign up";
    ViewData["PanelTitle"] = "Order ahead. Skip the line.";
    ViewData["PanelText"] = "Join in under a minute. Browse the daily menu, choose pickup or home delivery, and know exactly when your food is Ready.";
}

<span class="auth-kicker">Join Kaon</span>
<h1 class="auth-title">Create your account</h1>
<p class="auth-sub">It only takes a minute. No fees for customers.</p>

<form asp-action="Register" method="post" class="auth-form" novalidate>
    <div asp-validation-summary="ModelOnly" class="form-alert"></div>

    <div class="auth-grid">
        <div class="fld">
            <label class="fld-label" asp-for="FullName">Full name</label>
            <div class="fld-box">
                <svg class="fld-ico" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
                <input class="fld-input" asp-for="FullName" autocomplete="name" placeholder="Juan Dela Cruz" />
            </div>
            <span class="error" asp-validation-for="FullName"></span>
        </div>
        <div class="fld">
            <label class="fld-label" asp-for="Phone">Mobile number</label>
            <div class="fld-box">
                <svg class="fld-ico" viewBox="0 0 24 24"><rect x="7" y="2.5" width="10" height="19" rx="3"/><path d="M11 18h2"/></svg>
                <input class="fld-input" asp-for="Phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="09XX XXX XXXX" />
            </div>
            <span class="error" asp-validation-for="Phone"></span>
        </div>
    </div>

    <div class="fld">
        <label class="fld-label" asp-for="Email">Email</label>
        <div class="fld-box">
            <svg class="fld-ico" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3.5 7.5l8.5 6 8.5-6"/></svg>
            <input class="fld-input" asp-for="Email" type="email" autocomplete="email" placeholder="you@example.com" />
        </div>
        <span class="error" asp-validation-for="Email"></span>
    </div>

    <div class="auth-grid">
        <div class="fld">
            <label class="fld-label" asp-for="Password">Password</label>
            <div class="fld-box">
                <svg class="fld-ico" viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                <input class="fld-input" asp-for="Password" type="password" autocomplete="new-password" placeholder="Password" data-strength />
                <button type="button" class="fld-eye" aria-label="Show password" data-eye>
                    <svg viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
            </div>
            <div class="meter" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            <span class="meter-text" data-meter-text></span>
            <span class="error" asp-validation-for="Password"></span>
        </div>
        <div class="fld">
            <label class="fld-label" asp-for="ConfirmPassword">Confirm password</label>
            <div class="fld-box">
                <svg class="fld-ico" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.4 8-8 9-4.6-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
                <input class="fld-input" asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="Type it again" />
            </div>
            <span class="error" asp-validation-for="ConfirmPassword"></span>
        </div>
    </div>

    <button class="btn btn-go">Create account <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>

    <div class="auth-note">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5v.5"/></svg>
        <span>This is for customers. Carinderia owners get their account from the Kaon team.</span>
    </div>
</form>

<p class="auth-alt">Already have an account? <a asp-action="Login">Log in</a></p>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
