@model ForgotPasswordForm
@{
    Layout = "_Auth";
    ViewData["Title"] = "Forgot password";
    ViewData["PanelTitle"] = "Hungry? Skip the line.";
    ViewData["PanelText"] = "We will email you a private link so you can choose a new password.";
    var sent = ViewBag.Sent == true;
}

<span class="auth-kicker">Forgot password</span>
<h1 class="auth-title">Reset your password</h1>

@if (sent)
{
    <div class="auth-form">
        <p style="margin:0"><strong>Check your email.</strong></p>
        <p class="muted" style="margin:8px 0 0">If an account exists for that email, we sent a private link to choose a new password. It works once and expires in 1 hour.</p>
        <a class="btn" asp-action="Login">Back to log in</a>
    </div>
}
else
{
    <p class="auth-sub">Enter the email you signed up with.</p>
    <form asp-action="ForgotPassword" method="post" class="auth-form" novalidate>
        <div asp-validation-summary="ModelOnly" class="form-alert"></div>
        <div class="fld">
            <label class="fld-label" asp-for="Email">Email</label>
            <div class="fld-box">
                <svg class="fld-ico" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3.5 7.5l8.5 6 8.5-6"/></svg>
                <input class="fld-input" asp-for="Email" type="email" autocomplete="email" placeholder="you@example.com" />
            </div>
            <span class="error" asp-validation-for="Email"></span>
        </div>
        <button class="btn btn-go">Send me a link <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
    </form>
    <p class="auth-alt"><a asp-action="Login">&larr; Back to log in</a></p>
}
