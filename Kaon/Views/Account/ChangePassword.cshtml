@model ChangePasswordForm
@{
    Layout = "_Auth";
    ViewData["Title"] = "Change password";
    ViewData["PanelTitle"] = "Keep your account safe.";
    ViewData["PanelText"] = "Choose a password only you know. Use at least 8 characters.";
    var temporary = User.HasClaim("must_change", "1");
}

<span class="auth-kicker">@(temporary ? "First login" : "Account")</span>
<h1 class="auth-title">Choose a new password</h1>
<p class="auth-sub">
    @(temporary
        ? "You are using a temporary password. Please choose your own to continue."
        : "Enter your current password, then your new one.")
</p>

<form asp-action="ChangePassword" method="post" class="auth-form" novalidate>
    <div asp-validation-summary="ModelOnly" class="form-alert"></div>

    <div class="fld">
        <label class="fld-label" asp-for="CurrentPassword">@(temporary ? "Temporary password" : "Current password")</label>
        <div class="fld-box">
            <svg class="fld-ico" viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
            <input class="fld-input" asp-for="CurrentPassword" type="password" autocomplete="current-password" />
        </div>
        <span class="error" asp-validation-for="CurrentPassword"></span>
    </div>

    <div class="fld">
        <label class="fld-label" asp-for="NewPassword">New password</label>
        <div class="fld-box">
            <svg class="fld-ico" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.4 8-8 9-4.6-1-8-4-8-9V6z"/></svg>
            <input class="fld-input" asp-for="NewPassword" type="password" autocomplete="new-password" placeholder="At least 8 characters" data-strength />
            <button type="button" class="fld-eye" aria-label="Show password" data-eye>
                <svg viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
        </div>
        <div class="meter" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <span class="meter-text" data-meter-text></span>
        <span class="error" asp-validation-for="NewPassword"></span>
    </div>

    <div class="fld">
        <label class="fld-label" asp-for="ConfirmPassword">Confirm new password</label>
        <div class="fld-box">
            <svg class="fld-ico" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.4 8-8 9-4.6-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
            <input class="fld-input" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
        </div>
        <span class="error" asp-validation-for="ConfirmPassword"></span>
    </div>

    <button class="btn btn-go">Save password <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
</form>

@if (!temporary)
{
    <p class="auth-alt"><a href="javascript:history.back()">Cancel</a></p>
}

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
