@{
    Layout = "_Auth";
    ViewData["Title"] = "Link not valid";
    ViewData["PanelTitle"] = "Order ahead. Skip the line.";
    ViewData["PanelText"] = "Kaon helps local carinderias take orders ahead of time.";
}

<span class="auth-kicker">Link not valid</span>
<h1 class="auth-title">This link can't be used</h1>
<p class="auth-sub">It may have expired, or it was already used. For your safety each link works only once.</p>

<div class="auth-form">
    <p style="margin:0">Please ask the Kaon team to send you a new link. If you already set your password, you can simply log in.</p>
    <a class="btn" asp-action="Login">Go to log in</a>
</div>
