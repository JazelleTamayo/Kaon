@model LoginForm
@{
    Layout = "_Auth";
    var storeName = ViewBag.JoinStoreName as string;
    ViewData["Title"] = "Log in";
    ViewData["PanelTitle"] = storeName != null ? storeName : "Every order, one dashboard.";
    ViewData["PanelText"] = storeName != null
        ? "Log in to see today's menu, order ahead and follow your order in real time."
        : "Carinderia owners and the Kaon team log in here.";
}

@if (storeName != null)
{
    <span class="auth-kicker">Welcome back</span>
    <h1 class="auth-title">Log in to @storeName</h1>
    <p class="auth-sub">Use the account you created at @storeName.</p>
}
else
{
    <span class="auth-kicker">Owners and the Kaon team</span>
    <h1 class="auth-title">Log in to Kaon</h1>
    <p class="auth-sub">Customers: open your carinderia's own link or scan its QR code to log in and order.</p>
}

<form asp-action="Login" method="post" class="auth-form" novalidate>
    <div asp-validation-summary="ModelOnly" class="form-alert"></div>

    <div class="fld">
        <label class="fld-label" asp-for="Email">Email</label>
        <div class="fld-box">
            <svg class="fld-ico" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3.5 7.5l8.5 6 8.5-6"/></svg>
            <input class="fld-input" asp-for="Email" type="email" autocomplete="off" placeholder="you@example.com" />
        </div>
        <span class="error" asp-validation-for="Email"></span>
    </div>

    <div class="fld">
        <label class="fld-label" asp-for="Password">Password</label>
        <div class="fld-box">
            <svg class="fld-ico" viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
            <input class="fld-input" asp-for="Password" type="password" autocomplete="new-password" placeholder="Your password" />
            <button type="button" class="fld-eye" aria-label="Show password" data-eye>
                <svg viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
        </div>
        <span class="error" asp-validation-for="Password"></span>
    </div>

    <a class="forgot" asp-action="ForgotPassword">Forgot password?</a>

    <button class="btn btn-go">Log in <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
</form>

@if (storeName != null)
{
    <p class="auth-alt">New here? <a asp-action="Register">Create an account</a></p>
}
else
{
    <p class="auth-alt">Own a carinderia? <a asp-controller="Apply" asp-action="Index">Get Kaon for your carinderia</a></p>
}

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
