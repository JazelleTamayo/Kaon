@model OwnerFeedbackVm
@{
    ViewData["Title"] = "Feedback";
    ViewData["Wide"] = true;
    var s = Model.Stats;
    var last = Model.LastSurvey;
    string Pct(double? v) => v == null ? "-" : Math.Round(v.Value) + "%";
}

<section class="ob-hero no-print">
    <div class="o-hero-bg" aria-hidden="true"></div>
    <header class="ob-bar">
        <div class="ob-id">
            <h1>Feedback</h1>
            <span class="ob-sub">What customers say, and the orders that went wrong</span>
        </div>
    </header>
</section>

<div class="ob-stats" role="group" aria-label="Feedback at a glance">
    <div class="ob-stat"><span class="n">@(s.AverageRating == null ? "-" : s.AverageRating.Value.ToString("0.0") + " ★")</span><span class="l">Average rating · @s.Responses answer@(s.Responses == 1 ? "" : "s")</span></div>
    <div class="ob-stat"><span class="n">@Pct(s.FeeYesPercent)</span><span class="l">say the ₱@Model.DeliveryFee.ToString("N0") delivery fee is fair</span></div>
    <div class="ob-stat"><span class="n">@(s.AverageMinutesSaved == null ? "-" : "~" + Math.Round(s.AverageMinutesSaved.Value) + " min")</span><span class="l">waiting time saved per order</span></div>
    <div class="ob-stat @(s.ProblemsLast7Days > 0 ? "is-alert" : "")"><span class="n">@s.ProblemsLast7Days</span><span class="l">orders that went wrong this week</span></div>
</div>

<div class="tabs" role="tablist" aria-label="Feedback sections" data-tabs>
    <button type="button" role="tab" class="tab" data-tab="ratings" aria-selected="true">Customer ratings <span class="tab-n">@s.Responses</span></button>
    <button type="button" role="tab" class="tab" data-tab="problems" aria-selected="false">Report a problem <span class="tab-n">@s.ProblemsLast7Days</span></button>
    <button type="button" role="tab" class="tab" data-tab="survey" aria-selected="false">My survey</button>
</div>

@* ================= Customer ratings ================= *@
<section class="tab-panel" data-panel="ratings" role="tabpanel">
    <p class="muted fb-intro">Customers can rate an order once they have received it.</p>
    <div class="grid-2">
        <div>
            <h2 class="section">Comments and ratings</h2>
            @if (!Model.Recent.Any())
            {
                <div class="card"><p class="muted" style="margin:0">No feedback yet. Customers are asked once their order is completed.</p></div>
            }
            else
            {
                <div class="card fb-list">
                    @foreach (var f in Model.Recent)
                    {
                        <div class="fb-item">
                            <div class="row">
                                <span class="fb-stars" aria-label="@f.Rating out of 5">@(new string('★', f.Rating))<span class="off">@(new string('★', 5 - f.Rating))</span></span>
                                <span class="muted">Order #@f.OrderId · @f.CreatedAt.ToString("MMM d")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(f.Comment)) { <p class="fb-comment">@f.Comment</p> }
                            <div class="fb-tags">
                                @if (f.FeeReasonable != null) { <span class="chip chip-sm @(f.FeeReasonable == true ? "chip-ready" : "chip-cancelled")">Fee @(f.FeeReasonable == true ? "fair" : "too high")</span> }
                                @if (f.TimeSaved != null) { <span class="chip chip-sm chip-soldout">Saved: @TimeSaved.Text(f.TimeSaved).ToLower()</span> }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div>
            <h2 class="section">How much waiting time did ordering ahead save?</h2>
            <div class="card">
                @if (s.TimeAnswers > 0)
                {
                    @foreach (var (text, count) in s.TimeSavedCounts)
                    {
                        var pct = 100.0 * count / s.TimeAnswers;
                        <div class="bar-row">
                            <span>@text</span>
                            <span class="bar"><span style="width:@pct.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%"></span></span>
                            <strong>@count</strong>
                        </div>
                    }
                }
                else
                {
                    <p class="muted" style="margin:0">No answers yet. Customers are asked this after their order.</p>
                }
            </div>
        </div>
    </div>
</section>

@* ================= Report a problem ================= *@
<section class="tab-panel" data-panel="problems" id="problems" role="tabpanel" hidden>
    <div class="grid-2">
        <div>
            <h2 class="section">Write down an order that went wrong</h2>
            <form asp-action="LogProblem" method="post" class="card">
                <span class="label" style="margin-top:0">1. What happened?</span>
                <div class="kind-grid">
                    @foreach (var k in Enum.GetValues<ProblemKind>())
                    {
                        <label class="kind-opt">
                            <input type="radio" name="kind" value="@k" required />
                            <span><strong>@ProblemText.Label(k)</strong><small>@ProblemText.Hint(k)</small></span>
                        </label>
                    }
                </div>

                <span class="label">2. Which order? <span class="muted" style="font-weight:400">(optional, leave empty for a walk-in)</span></span>
                <input class="input" id="orderId" name="orderId" type="number" min="1" inputmode="numeric" placeholder="Order number, for example 12" aria-label="Order number" />

                <span class="label">3. Anything to add? <span class="muted" style="font-weight:400">(optional)</span></span>
                <input class="input" id="note" name="note" maxlength="300" placeholder="What happened?" aria-label="Note" />

                <button class="btn" style="margin-top:16px">Log this problem</button>
            </form>
        </div>

        <div>
            <h2 class="section">This week, and before Kaon</h2>
            <div class="card">
                <div class="compare" style="margin-top:0">
                    <div><strong>@(s.ProblemsPerWeekBefore?.ToString() ?? "?")</strong><span>a week before Kaon (your guess)</span></div>
                    <div><strong>@s.ProblemsPerWeekLast4Weeks.ToString("0.#")</strong><span>a week now (last 4 weeks)</span></div>
                </div>
                @if (s.ProblemsPerWeekBefore == null)
                {
                    <p class="hint">Answer the short survey in the <strong>My survey</strong> tab to fill in the "before" number.</p>
                }

                <h3 class="fb-sub">Recent problems</h3>
                @if (!Model.Problems.Any())
                {
                    <p class="muted" style="margin:0">Nothing written down yet. That is good news.</p>
                }
                else
                {
                    <ul class="problem-list">
                        @foreach (var p in Model.Problems)
                        {
                            <li>
                                <span>
                                    <span class="chip chip-sm chip-soldout">@ProblemText.Label(p.Kind)</span>
                                    @(p.OrderId != null ? "Order #" + p.OrderId : "Walk-in")
                                    @if (!string.IsNullOrEmpty(p.Note)) { <span class="muted">· @p.Note</span> }
                                    <span class="muted">· @p.At.ToString("MMM d, h:mm tt")</span>
                                </span>
                                <form asp-action="DeleteProblem" asp-route-id="@p.Id" method="post"><button class="btn-ghost" title="Remove (logged by mistake)">Remove</button></form>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</section>

@* ================= My survey ================= *@
<section class="tab-panel" data-panel="survey" id="survey" role="tabpanel" hidden>
    <div class="fb-narrow">
        <h2 class="section">A short survey for you</h2>
        <form asp-action="Survey" method="post" class="card">
            <p class="muted" style="margin-top:0">Two quick questions about how Kaon is working for you. It helps the Kaon team see what changed.@(last != null ? " Last answered " + last.CreatedAt.ToString("MMMM d") + ". You can answer again any time." : "")</p>

            <fieldset class="survey-q" style="border:0;padding:0;margin:0 0 14px">
                <legend style="font-weight:600;padding:0;margin-bottom:8px">1. How much does keeping pickup and delivery orders apart help you?</legend>
                <div class="pill-pick">
                    @for (var i = 1; i <= 5; i++)
                    {
                        var text = i switch { 1 => "1 · Not at all", 3 => "3 · Some", 5 => "5 · A lot", _ => i.ToString() };
                        <label><input type="radio" name="SeparationRating" value="@i" required checked="@(last?.SeparationRating == i)" /> <span>@text</span></label>
                    }
                </div>
            </fieldset>

            <label class="label" for="ProblemsPerWeekBefore">2. Before Kaon, about how many orders a week were mixed up, forgotten or late?</label>
            <input class="input" id="ProblemsPerWeekBefore" name="ProblemsPerWeekBefore" type="number" min="0" max="500" inputmode="numeric" placeholder="For example 5" value="@last?.ProblemsPerWeekBefore" style="max-width:200px" />

            <label class="label" for="ownerComment">Anything else? <span class="muted" style="font-weight:400">(optional)</span></label>
            <textarea class="input" id="ownerComment" name="Comment" maxlength="500" rows="2"></textarea>

            <button class="btn" style="margin-top:16px">Save my answers</button>
        </form>
    </div>
</section>

@section Scripts {
    <script>
        // Tabs: one section at a time, and the page remembers which one you were on
        (function () {
            var tabs = document.querySelectorAll('[data-tabs] .tab');
            var panels = document.querySelectorAll('[data-panel]');
            function show(name) {
                tabs.forEach(function (t) { t.setAttribute('aria-selected', t.dataset.tab === name ? 'true' : 'false'); });
                panels.forEach(function (p) { p.hidden = p.dataset.panel !== name; });
                try { sessionStorage.setItem('feedbackTab', name); } catch (e) { }
            }
            var start = (location.hash || '').replace('#', '');
            try { start = start || sessionStorage.getItem('feedbackTab') || ''; } catch (e) { }
            if (!document.querySelector('[data-panel="' + start + '"]')) start = 'ratings';
            tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.dataset.tab); }); });
            show(start);
        })();
    </script>
}
