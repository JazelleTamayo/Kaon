@model BoardVm
@using Kaon.Helpers
@{
    ViewData["Title"] = "Orders";
    ViewData["Wide"] = true;

    var columns = new[]
    {
        (OrderStatus.Pending, "Pending", "Waiting for you to accept"),
        (OrderStatus.Preparing, "Preparing", "In the kitchen"),
        (OrderStatus.Ready, "Ready", "Waiting for pickup or a rider"),
        (OrderStatus.OutForDelivery, "Out for Delivery", "On the way")
    };

    var kitchenColumns = new[]
    {
        (OrderStatus.Preparing, "Preparing", "In the kitchen"),
        (OrderStatus.Ready, "Ready", "Waiting for pickup or a rider"),
        (OrderStatus.OutForDelivery, "Out for Delivery", "On the way")
    };

        var waiting = Model.Active.Count(o => o.Status == OrderStatus.Pending);
    var onPackages = ViewBag.Tab as string == "packages";
}

<section class="ob-hero">
<div class="o-hero-bg" aria-hidden="true"></div>
<header class="ob-bar">
    <div class="ob-id">
        <h1>Orders</h1>
        <span class="ob-sub">@Model.Store.Name &middot; @DateTime.Today.ToString("dddd, MMMM d")</span>
    </div>
    <div class="ob-actions">
        <form asp-action="ToggleOpen" method="post" class="mini-switch @(Model.Store.IsOpen ? "is-on" : "")" title="@(Model.Store.IsOpen ? "Customers can order now. Switch off to stop new orders." : "Customers can't order. Switch on to open.")">
            <label class="switch">
                <input type="checkbox" @(Model.Store.IsOpen ? "checked" : "") onchange="this.form.submit()" role="switch" aria-label="Open for orders" />
                <span class="slider"></span>
            </label>
            <span class="ms-label">@(Model.Store.IsOpen ? "Open for orders" : "Closed")</span>
        </form>
        <div class="mini-switch" id="alertSwitch" title="Play a sound when a new order comes in">
            <label class="switch">
                <input type="checkbox" id="alertBtn" role="switch" aria-label="Sound alerts for new orders" />
                <span class="slider"></span>
            </label>
            <span class="ms-label" id="alertTitle">Sound alerts</span>
        </div>
    </div>
</header>
</section>

<div class="ob-stats" role="group" aria-label="Orders at a glance">
    <div class="ob-stat"><span class="n" data-count="@Model.Active.Count">@Model.Active.Count</span><span class="l">Active orders</span></div>
    <div class="ob-stat @(waiting > 0 ? "is-alert" : "")"><span class="n" data-count="@waiting">@waiting</span><span class="l">Waiting to accept</span></div>
    <div class="ob-stat"><span class="n" data-count="@Model.OrdersToday">@Model.OrdersToday</span><span class="l">Orders today</span></div>
    <div class="ob-stat"><span class="n" data-count="@((int)Model.SalesToday)" data-prefix="₱">₱@Model.SalesToday.ToString("N0")</span><span class="l">Sales (completed)</span></div>
</div>

@if ((int)ViewBag.DishCount == 0)
{
    <section class="card start-card">
        <div>
            <span class="share-kicker">Get started</span>
            <h2>Welcome! Three quick steps to open your carinderia</h2>
        </div>
        <ol class="steps-num">
            <li><div>
                <strong>Add your dishes</strong>
                <p class="muted" style="margin:2px 0 8px">Add your own, or start with sample dishes and change them later.</p>
                <div class="share-actions">
                    <a class="btn btn-sm" asp-controller="OwnerMenu" asp-action="Create" style="margin:0">Add a dish</a>
                    <form asp-controller="OwnerMenu" asp-action="StarterMenu" method="post"><button class="btn btn-sm btn-outline" style="margin:0">Add sample dishes</button></form>
                </div>
            </div></li>
            <li><div>
                <strong>Set how you get paid</strong>
                <p class="muted" style="margin:2px 0 0">Your hours, delivery and GCash details. <a asp-controller="OwnerSettings" asp-action="Index">Open Store setup</a></p>
            </div></li>
            <li><div>
                <strong>Share your link and QR code</strong>
                <p class="muted" style="margin:2px 0 0">Customers order from your own link. <a asp-controller="OwnerSettings" asp-action="Index" asp-fragment="share">Get my QR code</a></p>
            </div></li>
        </ol>
    </section>
}

@{
    var packageCount = Model.PackagePending.Count + Model.PackageReserved.Count + Model.PackageKitchen.Count;
}
<div class="tab-switch">
    <a class="tab @(!onPackages ? "active" : "")" asp-action="Index">Today's orders <span class="tab-badge @(waiting > 0 ? "is-new" : "")">@Model.Active.Count</span></a>
    <a class="tab @(onPackages ? "active" : "")" asp-action="Index" asp-route-tab="packages">Food package pre-orders <span class="tab-badge @(Model.PackagePending.Count > 0 ? "is-new" : "")">@packageCount</span></a>
</div>

@if (!onPackages)
{
    <div class="board board-fill">
        @foreach (var (status, title, hint) in columns)
        {
            var orders = Model.Active.Where(o => o.Status == status).ToList();
            var cls = status.ToString().ToLower();
            <section class="board-col col-@cls" aria-label="@title">
                <div class="board-top">
                    <div class="board-head">
                    <span class="bh-title"><span class="bh-dot"></span>@title</span>
                    <span class="chip chip-@cls">@orders.Count</span>
                </div>
                    <div class="bh-hint">@hint</div>
                </div>

                @if (!orders.Any())
                {
                    <div class="board-empty">
                        <svg class="pot" viewBox="0 0 64 64" aria-hidden="true">
                            <path class="steam s1" d="M24 18c-3-3 3-5 0-9"/><path class="steam s2" d="M32 18c-3-3 3-5 0-11"/><path class="steam s3" d="M40 18c-3-3 3-5 0-9"/>
                            <rect x="14" y="26" width="36" height="6" rx="3"/><path d="M17 32h30a15 15 0 0 1-30 0z"/>
                        </svg>
                        <span>@(status == OrderStatus.Pending ? "No new orders yet" : "Nothing here")</span>
                    </div>
                }

                @foreach (var o in orders)
                {
                    <partial name="_OrderCard" model="(o, Model.Riders)" />
                }
            </section>
        }
    </div>
}
else
{
    <div class="board">
        <section class="board-col col-pending" aria-label="Pending">
            <div class="board-top">
                <div class="board-head">
                <span class="bh-title"><span class="bh-dot"></span>Pending</span>
                <span class="chip chip-pending">@Model.PackagePending.Count</span>
            </div>
                <div class="bh-hint">Waiting for you to confirm</div>
            </div>
            @if (!Model.PackagePending.Any())
            {
                <div class="board-empty">
                    <svg class="pot" viewBox="0 0 64 64" aria-hidden="true">
                        <path class="steam s1" d="M24 18c-3-3 3-5 0-9"/><path class="steam s2" d="M32 18c-3-3 3-5 0-11"/><path class="steam s3" d="M40 18c-3-3 3-5 0-9"/>
                        <rect x="14" y="26" width="36" height="6" rx="3"/><path d="M17 32h30a15 15 0 0 1-30 0z"/>
                    </svg>
                    <span>No new pre-orders yet</span>
                </div>
            }
            @foreach (var o in Model.PackagePending)
            {
                <partial name="_OrderCard" model="(o, Model.Riders)" />
            }
        </section>

        <section class="board-col col-reserved" aria-label="Reserved">
            <div class="board-top">
                <div class="board-head">
                <span class="bh-title"><span class="bh-dot"></span>Reserved, by pickup date</span>
                <span class="chip chip-reserved">@Model.PackageReserved.Count</span>
            </div>
                <div class="bh-hint">Confirmed, waiting for their date</div>
            </div>
            @if (!Model.PackageReserved.Any())
            {
                <div class="board-empty">
                    <svg class="pot" viewBox="0 0 64 64" aria-hidden="true">
                        <path class="steam s1" d="M24 18c-3-3 3-5 0-9"/><path class="steam s2" d="M32 18c-3-3 3-5 0-11"/><path class="steam s3" d="M40 18c-3-3 3-5 0-9"/>
                        <rect x="14" y="26" width="36" height="6" rx="3"/><path d="M17 32h30a15 15 0 0 1-30 0z"/>
                    </svg>
                    <span>Nothing here</span>
                </div>
            }
            @foreach (var o in Model.PackageReserved)
            {
                <partial name="_OrderCard" model="(o, Model.Riders)" />
            }
        </section>
    </div>

    <h2 class="section" style="margin-top:24px">In the kitchen</h2>
    <div class="board">
        @foreach (var (status, title, hint) in kitchenColumns)
        {
            var orders = Model.PackageKitchen.Where(o => o.Status == status).ToList();
            var cls = status.ToString().ToLower();
            <section class="board-col col-@cls" aria-label="@title">
                <div class="board-top">
                    <div class="board-head">
                    <span class="bh-title"><span class="bh-dot"></span>@title</span>
                    <span class="chip chip-@cls">@orders.Count</span>
                </div>
                    <div class="bh-hint">@hint</div>
                </div>

                @if (!orders.Any())
                {
                    <div class="board-empty">
                        <svg class="pot" viewBox="0 0 64 64" aria-hidden="true">
                            <path class="steam s1" d="M24 18c-3-3 3-5 0-9"/><path class="steam s2" d="M32 18c-3-3 3-5 0-11"/><path class="steam s3" d="M40 18c-3-3 3-5 0-9"/>
                            <rect x="14" y="26" width="36" height="6" rx="3"/><path d="M17 32h30a15 15 0 0 1-30 0z"/>
                        </svg>
                        <span>Nothing here</span>
                    </div>
                }

                @foreach (var o in orders)
                {
                    <partial name="_OrderCard" model="(o, Model.Riders)" />
                }
            </section>
        }
    </div>
}

@section Scripts {
    <script>
        const stateUrl = '@Url.Action("BoardState")';
        const alertBtn = document.getElementById('alertBtn');
        const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let last = null;

        // The alerts switch mirrors what is saved in this browser
        function paintAlertBtn() {
            const on = kaonAlerts.enabled();
            alertBtn.checked = on;
            const box = document.getElementById('alertSwitch');
            box.classList.toggle('is-on', on);
            document.getElementById('alertTitle').textContent = on ? 'Sound alerts on' : 'Sound alerts off';
            box.title = on && kaonAlerts.permission() === 'denied'
                ? 'Sound is on. Pop-up notifications are blocked in this browser.'
                : 'Play a sound when a new order comes in';
        }
        alertBtn.addEventListener('change', () => { alertBtn.checked ? kaonAlerts.enable() : kaonAlerts.disable(); });
        kaonAlerts.onChange(paintAlertBtn);
        paintAlertBtn();

        // Numbers count up when the page opens or the board refreshes
        function countUp(root) {
            root.querySelectorAll('[data-count]').forEach(el => {
                const end = Number(el.dataset.count), pre = el.dataset.prefix || '';
                if (calm || !end) { el.textContent = pre + end.toLocaleString('en-PH'); return; }
                const t0 = performance.now(), dur = 900;
                (function step(t) {
                    const p = Math.min(1, (t - t0) / dur);
                    el.textContent = pre + Math.round(end * (1 - Math.pow(1 - p, 3))).toLocaleString('en-PH');
                    if (p < 1) requestAnimationFrame(step);
                })(t0);
            });
        }
        countUp(document);

        // Replace the stats and the board without reloading the page
        // The Today's orders board fills the screen below it; each column scrolls inside
        function fitBoard() {
            const b = document.querySelector('.board-fill');
            if (!b) return;
            if (innerWidth < 900) { b.style.height = ''; return; }
            b.style.height = '';
            // Never shorter than one complete order card (with its header), so a single order never needs scrolling
            let tallest = 0;
            b.querySelectorAll('.order-card').forEach(c => { tallest = Math.max(tallest, c.offsetHeight); });
            const oneCard = tallest ? Math.min(3 * tallest + 130, 900) : 0;   // room for three orders before it scrolls
            b.style.height = Math.max(400, oneCard, Math.round(innerHeight - b.getBoundingClientRect().top - 24)) + 'px';
        }
        window.addEventListener('resize', fitBoard);
        window.addEventListener('load', fitBoard);
        fitBoard();

        async function refresh() {
            const html = await (await fetch(location.href, { cache: 'no-store', credentials: 'same-origin' })).text();
            const doc = new DOMParser().parseFromString(html, 'text/html');
            // Remember how far each column was scrolled, so a refresh does not jump back to the top
            const scrolls = [...document.querySelectorAll('.board-col')].map(c => c.scrollTop);
            ['.ob-stats', '.tab-switch', '.board'].forEach(sel => {
                const fresh = doc.querySelector(sel), old = document.querySelector(sel);
                if (fresh && old) old.replaceWith(fresh);
            });
            fitBoard();
            document.querySelectorAll('.board-col').forEach((c, i) => { if (scrolls[i]) c.scrollTop = scrolls[i]; });
            const stats = document.querySelector('.ob-stats');
            if (stats) countUp(stats);
        }

        const ids = sig => sig.split(',').filter(Boolean).map(x => x.split(':')[0]);
        const soonIds = sig => sig.split(',').filter(Boolean).filter(x => x.split(':')[2] === '1').map(x => x.split(':')[0]);

        async function check() {
            try {
                const r = await fetch(stateUrl, { cache: 'no-store', credentials: 'same-origin' });
                // The subscription ended while the board was open: go to the billing page
                if (r.redirected || r.status === 402) { location.href = '@Url.Action("Index", "Billing")'; return; }
                if (!r.ok) return;
                const d = await r.json();
                // Don't redraw the board while the owner is choosing a cancel reason; check again next time
                if (document.querySelector('.cancel-box[open], .more-menu[open]')) return;
                if (last !== null && d.sig !== last) {
                    const before = new Set(ids(last));
                    const fresh = ids(d.sig).filter(id => !before.has(id));
                    const soonBefore = new Set(soonIds(last));
                    const newlySoon = soonIds(d.sig).filter(id => !soonBefore.has(id));
                    await refresh();
                    if (fresh.length) {
                        kaonAlerts.notify('New order', 'New order' + (fresh.length > 1 ? 's' : '') + ': #' + fresh.join(', #'), { kind: 'ready', tag: 'new-order' });
                    } else if (newlySoon.length) {
                        kaonAlerts.notify('Prepare soon', 'Reserved order' + (newlySoon.length > 1 ? 's' : '') + ' coming up: #' + newlySoon.join(', #'), { kind: 'ready', tag: 'prep-soon' });
                    }
                }
                last = d.sig;
            } catch (e) { }
        }
        check();
        setInterval(check, 5000);
    </script>
}
