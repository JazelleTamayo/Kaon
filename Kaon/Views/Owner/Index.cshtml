@model BoardVm
@using Kaon.Helpers
@{
    ViewData["Title"] = "Orders";
    ViewData["Wide"] = true;

    var columns = new[]
    {
        (OrderStatus.Pending, "Pending", "Waiting for you to accept"),
        (OrderStatus.Preparing, "Preparing", "In the kitchen"),
        (OrderStatus.Ready, "Ready", "Waiting for pickup or a rider"),
        (OrderStatus.OutForDelivery, "Out for Delivery", "On the way")
    };

    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";
    var waiting = Model.Active.Count(o => o.Status == OrderStatus.Pending);
}

<section class="o-hero">
    <div class="o-hero-bg" aria-hidden="true"></div>
    <div class="o-hero-in">
        <span class="o-kicker">@greeting!</span>
        <h1>@Model.Store.Name</h1>
        <p>@DateTime.Today.ToString("dddd, MMMM d") · @(waiting > 0 ? waiting + " order" + (waiting == 1 ? "" : "s") + " waiting for you" : "You're all caught up")</p>
        <div class="o-hero-actions">
            <form asp-action="ToggleOpen" method="post">
                <button class="open-toggle @(Model.Store.IsOpen ? "is-open" : "is-closed")" title="Tap to switch">
                    <span class="dot"></span> @(Model.Store.IsOpen ? "Open for orders" : "Closed")
                </button>
            </form>
            <a class="alert-toggle" style="text-decoration:none" asp-controller="OwnerSettings" asp-action="Index" asp-fragment="share">Your QR code and link</a>
            <button type="button" class="alert-toggle" id="alertBtn">Turn on alerts</button>
        </div>
    </div>
</section>

<div class="stats o-stats">
    <div class="stat c-orange">
        <span class="stat-ico"><svg viewBox="0 0 24 24"><path d="M4 12h16a8 8 0 0 1-16 0z"/><path d="M9 7c-1-1 1-2 0-3M14 7c-1-1 1-2 0-3"/></svg></span>
        <span class="stat-num" data-count="@Model.Active.Count">@Model.Active.Count</span><span class="stat-label">Active orders now</span>
    </div>
    <div class="stat c-yellow">
        <span class="stat-ico"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
        <span class="stat-num" data-count="@waiting">@waiting</span><span class="stat-label">Waiting to accept</span>
    </div>
    <div class="stat c-teal">
        <span class="stat-ico"><svg viewBox="0 0 24 24"><rect x="4" y="8" width="16" height="12" rx="3"/><path d="M8 8a4 4 0 0 1 8 0"/></svg></span>
        <span class="stat-num" data-count="@Model.OrdersToday">@Model.OrdersToday</span><span class="stat-label">Orders today</span>
    </div>
    <div class="stat c-green">
        <span class="stat-ico"><svg viewBox="0 0 24 24"><path d="M12 3v18M16.5 7.5c-.8-1.4-2.4-2-4.5-2-2.6 0-4.2 1.2-4.2 3 0 4.4 9 2 9 6.5 0 1.9-1.8 3.2-4.8 3.2-2.3 0-4-.8-5-2.3"/></svg></span>
        <span class="stat-num" data-count="@((int)Model.SalesToday)" data-prefix="₱">₱@Model.SalesToday.ToString("N0")</span><span class="stat-label">Sales (completed)</span>
    </div>
</div>

@if ((int)ViewBag.DishCount == 0)
{
    <section class="card start-card">
        <div>
            <span class="share-kicker">Get started</span>
            <h2>Welcome! Three quick steps to open your carinderia</h2>
        </div>
        <ol class="steps-num">
            <li><div>
                <strong>Add your dishes</strong>
                <p class="muted" style="margin:2px 0 8px">Add your own, or start with sample dishes and change them later.</p>
                <div class="share-actions">
                    <a class="btn btn-sm" asp-controller="OwnerMenu" asp-action="Create" style="margin:0">Add a dish</a>
                    <form asp-controller="OwnerMenu" asp-action="StarterMenu" method="post"><button class="btn btn-sm btn-outline" style="margin:0">Add sample dishes</button></form>
                </div>
            </div></li>
            <li><div>
                <strong>Set how you get paid</strong>
                <p class="muted" style="margin:2px 0 0">Your hours, delivery and GCash details. <a asp-controller="OwnerSettings" asp-action="Index">Open Store setup</a></p>
            </div></li>
            <li><div>
                <strong>Share your link and QR code</strong>
                <p class="muted" style="margin:2px 0 0">Customers order from your own link. <a asp-controller="OwnerSettings" asp-action="Index" asp-fragment="share">Get my QR code</a></p>
            </div></li>
        </ol>
    </section>
}

<nav class="quick" aria-label="Quick actions">
    <a asp-controller="OwnerMenu" asp-action="Create">
        <span class="q-ico"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span>Add a food
    </a>
    <a asp-controller="OwnerMenu" asp-action="Index">
        <span class="q-ico"><svg viewBox="0 0 24 24"><path d="M4 12h16a8 8 0 0 1-16 0z"/><path d="M9 7c-1-1 1-2 0-3M14 7c-1-1 1-2 0-3"/></svg></span>Today's menu
    </a>
    <a asp-controller="Owner" asp-action="Summary">
        <span class="q-ico"><svg viewBox="0 0 24 24"><path d="M5 20V10M12 20V4M19 20v-7"/></svg></span>End-of-day summary
    </a>
    <a asp-controller="OwnerSettings" asp-action="Index">
        <span class="q-ico"><svg viewBox="0 0 24 24"><path d="M4 9l1.5-5h13L20 9M4 9v11h16V9M4 9h16M9 20v-6h6v6"/></svg></span>Store &amp; payments
    </a>
</nav>

<div class="board">
    @foreach (var (status, title, hint) in columns)
    {
        var orders = Model.Active.Where(o => o.Status == status).ToList();
        var cls = status.ToString().ToLower();
        <section class="board-col col-@cls" aria-label="@title">
            <div class="board-head">
                <span class="bh-title"><span class="bh-dot"></span>@title</span>
                <span class="chip chip-@cls">@orders.Count</span>
            </div>
            <div class="bh-hint">@hint</div>

            @if (!orders.Any())
            {
                <div class="board-empty">
                    <svg class="pot" viewBox="0 0 64 64" aria-hidden="true">
                        <path class="steam s1" d="M24 18c-3-3 3-5 0-9"/><path class="steam s2" d="M32 18c-3-3 3-5 0-11"/><path class="steam s3" d="M40 18c-3-3 3-5 0-9"/>
                        <rect x="14" y="26" width="36" height="6" rx="3"/><path d="M17 32h30a15 15 0 0 1-30 0z"/>
                    </svg>
                    <span>@(status == OrderStatus.Pending ? "No new orders yet" : "Nothing here")</span>
                </div>
            }

            @foreach (var o in orders)
            {
                var mins = (int)(DateTime.Now - o.CreatedAt).TotalMinutes;
                var slow = (status == OrderStatus.Pending || status == OrderStatus.Preparing);
                var ageClass = slow && mins >= 15 ? "late" : slow && mins >= 8 ? "warn" : "";
                <article class="order-card @(mins < 2 ? "fresh" : "")">
                    <div class="row">
                        <strong>#@o.Id @if (mins < 2) { <span class="new-badge">New</span> }</strong>
                        <span class="tag @(o.OrderType == OrderType.Delivery ? "tag-delivery" : "tag-pickup")">
                            @(o.OrderType == OrderType.Delivery ? "Delivery" : "Pickup")
                        </span>
                    </div>
                    <div class="order-who">@o.CustomerName · @o.Phone</div>
                    @if (o.ScheduledFor != null)
                    {
                        var sameDay = o.ScheduledFor.Value.Date == o.CreatedAt.Date;
                        <div class="order-when">@(sameDay ? (o.OrderType == OrderType.Delivery ? "Deliver at" : "Pickup at") : "Needed"): @o.ScheduledFor.Value.ToString(sameDay ? "h:mm tt" : "MMM d, h:mm tt")</div>
                    }
                    @if (o.OrderType == OrderType.Delivery && !string.IsNullOrWhiteSpace(o.Address))
                    {
                        <div class="order-addr">@o.Address</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(o.Notes))
                    {
                        <div class="order-note"><strong>Note:</strong> @o.Notes</div>
                    }
                    <div class="pay-line">
                        <span class="pay-method">@OrderText.PayMethodLabel(o)</span>
                        <span class="chip @(o.PaymentStatus == PaymentStatus.Paid ? "chip-ready" : o.PaymentStatus == PaymentStatus.ProofSent ? "chip-pending" : "chip-soldout")">@OrderText.PayStatusLabel(o)</span>
                        @if (!string.IsNullOrEmpty(o.PaymentProof))
                        {
                            <a href="/Payment/Proof/@o.Id" target="_blank" rel="noopener">View proof</a>
                        }
                        @if (!string.IsNullOrEmpty(o.PaymentRef))
                        {
                            <span class="muted">Ref: @o.PaymentRef</span>
                        }
                    </div>
                    <ul class="order-lines">
                        @foreach (var i in o.Items)
                        {
                            <li>
                                @i.Quantity × @i.ItemName
                                @if (i.TracksReadiness)
                                {
                                    <span class="chip chip-sm @(i.IsReadyToServe ? "chip-ready" : "chip-preparing")">@(i.IsReadyToServe ? "Ready" : "Preparing")</span>
                                }
                            </li>
                        }
                    </ul>
                    <div class="row order-foot">
                        <span class="age @ageClass">@(mins < 1 ? "Just now" : mins < 120 ? mins + " min ago" : o.CreatedAt.ToString("MMM d, h:mm tt"))</span>
                        <strong>₱@o.Total.ToString("N2")</strong>
                    </div>
                    <div class="order-actions">
                        <form asp-action="Advance" asp-route-id="@o.Id" method="post">
                            <button class="btn btn-sm">@OrderText.NextLabel(o)</button>
                        </form>
                        @if (o.PaymentStatus != PaymentStatus.Paid)
                        {
                            <form asp-action="MarkPaid" asp-route-id="@o.Id" method="post">
                                <button class="btn-ghost">Mark paid</button>
                            </form>
                        }
                    </div>
                    <details class="cancel-box">
                        <summary class="btn-ghost danger">Cancel</summary>
                        <form asp-action="Cancel" asp-route-id="@o.Id" method="post" class="cancel-form">
                            <span class="label">Why are you cancelling? The customer will see this.</span>
                            @foreach (var r in OrderText.CancelReasons)
                            {
                                <label class="cancel-opt"><input type="radio" name="reason" value="@r" required /> @r</label>
                            }
                            <label class="cancel-opt"><input type="radio" name="reason" value="Other" /> Other</label>
                            <input class="input" name="otherReason" maxlength="200" placeholder="Type the reason (for Other)" />
                            <button class="btn btn-sm btn-danger">Cancel order #@o.Id</button>
                        </form>
                    </details>
                </article>
            }
        </section>
    }
</div>

@section Scripts {
    <script>
        const stateUrl = '@Url.Action("BoardState")';
        const alertBtn = document.getElementById('alertBtn');
        const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let last = null;

        function paintAlertBtn() {
            const on = kaonAlerts.enabled();
            alertBtn.classList.toggle('on', on);
            alertBtn.textContent = on ? 'Alerts on' : 'Turn on alerts';
        }
        alertBtn.addEventListener('click', () => { kaonAlerts.enabled() ? kaonAlerts.disable() : kaonAlerts.enable(); });
        kaonAlerts.onChange(paintAlertBtn);
        paintAlertBtn();

        // Numbers count up when the page opens or the board refreshes
        function countUp(root) {
            root.querySelectorAll('[data-count]').forEach(el => {
                const end = Number(el.dataset.count), pre = el.dataset.prefix || '';
                if (calm || !end) { el.textContent = pre + end.toLocaleString('en-PH'); return; }
                const t0 = performance.now(), dur = 900;
                (function step(t) {
                    const p = Math.min(1, (t - t0) / dur);
                    el.textContent = pre + Math.round(end * (1 - Math.pow(1 - p, 3))).toLocaleString('en-PH');
                    if (p < 1) requestAnimationFrame(step);
                })(t0);
            });
        }
        countUp(document);

        // Replace the stats and the board without reloading the page
        async function refresh() {
            const html = await (await fetch(location.href, { cache: 'no-store', credentials: 'same-origin' })).text();
            const doc = new DOMParser().parseFromString(html, 'text/html');
            ['.stats', '.board'].forEach(sel => {
                const fresh = doc.querySelector(sel), old = document.querySelector(sel);
                if (fresh && old) old.replaceWith(fresh);
            });
            countUp(document.querySelector('.stats'));
        }

        const ids = sig => sig.split(',').filter(Boolean).map(x => x.split(':')[0]);

        async function check() {
            try {
                const r = await fetch(stateUrl, { cache: 'no-store', credentials: 'same-origin' });
                // The subscription ended while the board was open: go to the billing page
                if (r.redirected || r.status === 402) { location.href = '@Url.Action("Index", "Billing")'; return; }
                if (!r.ok) return;
                const d = await r.json();
                // Don't redraw the board while the owner is choosing a cancel reason; check again next time
                if (document.querySelector('.cancel-box[open]')) return;
                if (last !== null && d.sig !== last) {
                    const before = new Set(ids(last));
                    const fresh = ids(d.sig).filter(id => !before.has(id));
                    await refresh();
                    if (fresh.length) {
                        kaonAlerts.notify('New order', 'New order' + (fresh.length > 1 ? 's' : '') + ': #' + fresh.join(', #'), { kind: 'ready', tag: 'new-order' });
                    }
                }
                last = d.sig;
            } catch (e) { }
        }
        check();
        setInterval(check, 5000);
    </script>
}
