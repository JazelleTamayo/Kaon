@model List<Order>
@using Kaon.Helpers
@{
    Layout = null;
    var store = (StoreSettings)ViewBag.Store;
    var type = ViewBag.Type as OrderType?;
    var single = ViewBag.Single == true;

    decimal Collect(Order o) => OrderText.ToCollect(o);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(single ? "Order #" + Model[0].Id : "Order slips") - @store.Name</title>
    <link rel="icon" type="image/svg+xml" href="~/img/logo-icon.svg" />
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; font-family: system-ui, -apple-system, 'Segoe UI', Arial, sans-serif; color: #111; background: #f4eee5; font-size: 14px; }
        .bar { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; gap: 12px 16px; flex-wrap: wrap; justify-content: space-between; padding: .7rem 20px; background: #2B1810; color: #fff; border-bottom: 3px solid #E8501F; }
        .bar a, .bar button { font: inherit; font-weight: 600; padding: .5rem 1rem; border-radius: 999px; border: 1.5px solid rgba(255,255,255,.35); background: transparent; color: #fff; text-decoration: none; cursor: pointer; }
        .bar a:hover { background: rgba(255,255,255,.12); }
        .bar .primary { background: #E8501F; border-color: #E8501F; color: #fff; padding: .5rem 1.4rem; }
        .bar .primary:hover { background: #c93f13; }
        .bar .on { background: #fff; color: #2B1810; border-color: #fff; }
        .bar-title { display: grid; font-weight: 700; font-size: 1.05rem; line-height: 1.2; text-align: center; }
        .bar-title small { font-weight: 400; opacity: .75; font-size: .8rem; }
        .bar-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
        .wrap { display: flex; flex-wrap: wrap; gap: 20px; justify-content: center; padding: 24px 16px 40px; }
        .empty { text-align: center; color: #6b5a4e; padding: 40px 16px; }

        /* About 80 mm wide: fits a receipt printer, and several fit on one A4 page */
        .slip { width: min(84mm, 100%); background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 8px 28px rgba(43,24,16,.14); break-inside: avoid; page-break-inside: avoid; }
        .slip-head { text-align: center; padding: 14px 14px 12px; background: #2B1810; color: #fff; }
        .slip .store { font-weight: 600; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; opacity: .9; }
        .slip .num { font-size: 36px; font-weight: 800; line-height: 1.1; margin: 2px 0 8px; color: #FFB703; }
        .slip .type { display: inline-block; font-weight: 800; letter-spacing: .14em; font-size: 13px; padding: 3px 16px; border-radius: 999px; border: 2px solid #fff; color: #fff; }
        .slip .type.delivery { background: #E8501F; border-color: #E8501F; }
        .slip-body { padding: 12px 16px 16px; }
        .slip .row { display: flex; justify-content: space-between; gap: 8px; }
        .slip .line { margin: 2px 0; }
        .slip .muted { color: #6b5a4e; font-size: 12px; }
        .slip hr { border: 0; border-top: 1px dashed #b9a88f; margin: 10px 0; }
        .slip .items { list-style: none; margin: 0; padding: 0; }
        .slip .items li { display: flex; justify-content: space-between; gap: 8px; margin: 4px 0; }
        .slip .items .q { font-weight: 700; min-width: 2.2em; }
        .slip .note { border: 1px solid #111; border-radius: 8px; padding: 6px 8px; margin-top: 8px; font-weight: 600; }
        .slip .total { font-weight: 800; font-size: 16px; margin-top: 2px; }
        .slip .collect { margin-top: 10px; text-align: center; font-weight: 800; font-size: 18px; border: 2px dashed #E8501F; color: #c93f13; border-radius: 10px; padding: 8px; background: #fff4e8; }
        .slip .collect.paid { font-size: 14px; border-color: #2E9E5B; color: #1f7a45; background: #eefaf2; }

        @@page { margin: 8mm; }
        @@media print {
            body { background: #fff; }
            .bar { display: none; }
            .wrap { padding: 0; gap: 6mm; justify-content: flex-start; }
            .slip { border: 1px dashed #777; border-radius: 0; box-shadow: none; }
            .slip-head { background: #fff; color: #111; border-bottom: 2px solid #111; }
            .slip .num { color: #111; }
            .slip .type, .slip .type.delivery { background: #fff; color: #111; border: 2px solid #111; border-radius: 0; }
            .slip .collect, .slip .collect.paid { background: #fff; color: #111; border-color: #111; }
        }
    </style>
</head>
<body>
    @{
        object RouteFor(OrderType? t) => new { type = t, period = (string?)ViewBag.Period, from = (ViewBag.From as DateTime?)?.ToString("yyyy-MM-dd"), to = (ViewBag.To as DateTime?)?.ToString("yyyy-MM-dd") };
        var rangeLabel = ViewBag.RangeLabel as string;
    }
    <div class="bar">
        <a class="back" href="@Url.Action("Index")" onclick="if (history.length > 1) { history.back(); return false; }">&larr; Back</a>
        <span class="bar-title">
            @if (single) { <text>Order slip</text> }
            else { <text>@(rangeLabel != null ? "All slips · " + rangeLabel : "Open orders")</text> }
            <small>@Model.Count slip@(Model.Count == 1 ? "" : "s")</small>
        </span>
        <span class="bar-actions">
            @if (!single)
            {
                <a class="@(type == null ? "on" : "")" href="@Url.Action("Slips", RouteFor(null))">All</a>
                <a class="@(type == OrderType.Pickup ? "on" : "")" href="@Url.Action("Slips", RouteFor(OrderType.Pickup))">Pickup</a>
                <a class="@(type == OrderType.Delivery ? "on" : "")" href="@Url.Action("Slips", RouteFor(OrderType.Delivery))">Delivery</a>
            }
            <button type="button" class="primary" onclick="window.print()">Print@(single ? "" : " all")</button>
        </span>
    </div>

    @if (!Model.Any())
    {
        <p class="empty">No open orders to print right now.</p>
    }

    <div class="wrap">
        @foreach (var o in Model)
        {
            var subtotal = o.Items.Sum(i => i.UnitPrice * i.Quantity);
            var collect = Collect(o);
            <article class="slip">
                <div class="slip-head">
                    <div class="store">@store.Name</div>
                    <div class="num">#@o.Id</div>
                    <div class="type @(o.OrderType == OrderType.Delivery ? "delivery" : "")">@(o.OrderType == OrderType.Delivery ? "DELIVERY" : "PICKUP")</div>
                </div>
                <div class="slip-body">

                <div class="line"><strong>@o.CustomerName</strong></div>
                @if (!string.IsNullOrWhiteSpace(o.Phone)) { <div class="line">@o.Phone</div> }
                @if (o.OrderType == OrderType.Delivery && !string.IsNullOrWhiteSpace(o.Address))
                {
                    <div class="line"><strong>Address:</strong> @o.Address</div>
                }
                @if (o.ScheduledFor != null)
                {
                    var sameDay = o.ScheduledFor.Value.Date == o.CreatedAt.Date;
                    <div class="line"><strong>@(o.OrderType == OrderType.Delivery ? "Deliver" : "Pickup"):</strong> @o.ScheduledFor.Value.ToString(sameDay ? "h:mm tt" : "ddd, MMM d, h:mm tt")</div>
                }
                <div class="muted">Ordered @o.CreatedAt.ToString("MMM d, h:mm tt")</div>
                @if (!string.IsNullOrWhiteSpace(o.RiderName)) { <div class="line"><strong>Rider:</strong> @o.RiderName · @o.RiderPhone</div> }

                <hr />
                <ul class="items">
                    @foreach (var i in o.Items)
                    {
                        <li><span><span class="q">@i.Quantity ×</span> @i.ItemName</span><span>₱@((i.UnitPrice * i.Quantity).ToString("N2"))</span></li>
                    }
                </ul>
                @if (!string.IsNullOrWhiteSpace(o.Notes)) { <div class="note">Note: @o.Notes</div> }
                <hr />

                <div class="row"><span>Food</span><span>₱@subtotal.ToString("N2")</span></div>
                @if (o.DeliveryFee > 0) { <div class="row"><span>Delivery fee</span><span>₱@o.DeliveryFee.ToString("N2")</span></div> }
                <div class="row total"><span>Total</span><span>₱@o.Total.ToString("N2")</span></div>
                @if (o.DepositAmount != null) { <div class="row muted"><span>Deposit</span><span>₱@o.DepositAmount.Value.ToString("N2")</span></div> }
                <div class="row muted"><span>@OrderText.PayMethodLabel(o)</span><span>@OrderText.PayStatusLabel(o)</span></div>

                @if (collect > 0)
                {
                    <div class="collect">Collect ₱@collect.ToString("N2")</div>
                    @if (o.PaymentStatus == PaymentStatus.ProofSent)
                    {
                        <div class="muted" style="text-align:center">Proof sent. Check it before collecting.</div>
                    }
                }
                else
                {
                    <div class="collect paid">PAID · nothing to collect</div>
                }
                </div>
            </article>
        }
    </div>
</body>
</html>
