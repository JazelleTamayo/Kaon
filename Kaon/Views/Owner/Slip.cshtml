@model List<Order>
@using Kaon.Helpers
@{
    Layout = null;
    var store = (StoreSettings)ViewBag.Store;
    var type = ViewBag.Type as OrderType?;
    var single = ViewBag.Single == true;

    // What is still to be collected in person when the order is handed over
    decimal Collect(Order o) => o.PaymentStatus switch
    {
        PaymentStatus.Paid => 0,
        PaymentStatus.DepositPaid => o.Total - (o.DepositAmount ?? 0),
        _ => o.Total
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(single ? "Order #" + Model[0].Id : "Order slips") - @store.Name</title>
    <link rel="icon" type="image/svg+xml" href="~/img/logo-icon.svg" />
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; font-family: system-ui, -apple-system, 'Segoe UI', Arial, sans-serif; color: #111; background: #efe6da; font-size: 14px; }
        .bar { position: sticky; top: 0; display: flex; gap: .5rem; flex-wrap: wrap; justify-content: center; padding: .8rem 16px; background: #fff; box-shadow: 0 2px 10px rgba(0,0,0,.06); }
        .bar button, .bar a { font: inherit; font-weight: 600; padding: .5rem 1rem; border-radius: 999px; border: 1px solid #e3d6c6; background: #fff; color: #2A1A12; text-decoration: none; cursor: pointer; }
        .bar .primary { background: #E8501F; border-color: #E8501F; color: #fff; }
        .bar .on { border-color: #E8501F; color: #E8501F; }
        .wrap { display: flex; flex-wrap: wrap; gap: 16px; justify-content: center; padding: 16px; }
        .empty { text-align: center; color: #6b5a4e; padding: 40px 16px; }

        /* About 80 mm wide: fits a receipt printer, and several fit on one A4 page */
        .slip { width: min(80mm, 100%); background: #fff; padding: 12px 14px; border: 1px dashed #999; break-inside: avoid; page-break-inside: avoid; }
        .slip .store { text-align: center; font-weight: 700; font-size: 15px; }
        .slip .num { text-align: center; font-size: 30px; font-weight: 800; line-height: 1.1; margin: 4px 0; }
        .slip .type { text-align: center; font-weight: 800; letter-spacing: .12em; font-size: 16px; padding: 4px 0; margin: 4px 0 8px; border: 2px solid #111; }
        .slip .type.delivery { background: #111; color: #fff; }
        .slip .row { display: flex; justify-content: space-between; gap: 8px; }
        .slip .line { margin: 2px 0; }
        .slip .muted { color: #555; font-size: 12px; }
        .slip hr { border: 0; border-top: 1px dashed #777; margin: 8px 0; }
        .slip .items { list-style: none; margin: 0; padding: 0; }
        .slip .items li { display: flex; justify-content: space-between; gap: 8px; margin: 3px 0; }
        .slip .items .q { font-weight: 700; min-width: 2.2em; }
        .slip .note { border: 1px solid #111; padding: 6px; margin-top: 8px; font-weight: 600; }
        .slip .total { font-weight: 800; font-size: 16px; }
        .slip .collect { margin-top: 8px; text-align: center; font-weight: 800; font-size: 18px; border: 2px dashed #111; padding: 6px; }
        .slip .collect.paid { font-size: 14px; }

        @@page { margin: 8mm; }
        @@media print {
            body { background: #fff; }
            .bar { display: none; }
            .wrap { padding: 0; gap: 6mm; justify-content: flex-start; }
            .slip { border-color: #777; }
        }
    </style>
</head>
<body>
    <div class="bar">
        <button type="button" class="primary" onclick="window.print()">Print</button>
        @if (!single)
        {
            <a class="@(type == null ? "on" : "")" href="@Url.Action("Slips")">All open orders</a>
            <a class="@(type == OrderType.Pickup ? "on" : "")" href="@Url.Action("Slips", new { type = OrderType.Pickup })">Pickup only</a>
            <a class="@(type == OrderType.Delivery ? "on" : "")" href="@Url.Action("Slips", new { type = OrderType.Delivery })">Delivery only</a>
        }
        <a href="@Url.Action("Index")">Back to orders</a>
    </div>

    @if (!Model.Any())
    {
        <p class="empty">No open orders to print right now.</p>
    }

    <div class="wrap">
        @foreach (var o in Model)
        {
            var subtotal = o.Items.Sum(i => i.UnitPrice * i.Quantity);
            var collect = Collect(o);
            <article class="slip">
                <div class="store">@store.Name</div>
                <div class="num">#@o.Id</div>
                <div class="type @(o.OrderType == OrderType.Delivery ? "delivery" : "")">@(o.OrderType == OrderType.Delivery ? "DELIVERY" : "PICKUP")</div>

                <div class="line"><strong>@o.CustomerName</strong></div>
                @if (!string.IsNullOrWhiteSpace(o.Phone)) { <div class="line">@o.Phone</div> }
                @if (o.OrderType == OrderType.Delivery && !string.IsNullOrWhiteSpace(o.Address))
                {
                    <div class="line"><strong>Address:</strong> @o.Address</div>
                }
                @if (o.ScheduledFor != null)
                {
                    var sameDay = o.ScheduledFor.Value.Date == o.CreatedAt.Date;
                    <div class="line"><strong>@(o.OrderType == OrderType.Delivery ? "Deliver" : "Pickup"):</strong> @o.ScheduledFor.Value.ToString(sameDay ? "h:mm tt" : "ddd, MMM d, h:mm tt")</div>
                }
                <div class="muted">Ordered @o.CreatedAt.ToString("MMM d, h:mm tt")</div>

                <hr />
                <ul class="items">
                    @foreach (var i in o.Items)
                    {
                        <li><span><span class="q">@i.Quantity ×</span> @i.ItemName</span><span>₱@((i.UnitPrice * i.Quantity).ToString("N2"))</span></li>
                    }
                </ul>
                @if (!string.IsNullOrWhiteSpace(o.Notes)) { <div class="note">Note: @o.Notes</div> }
                <hr />

                <div class="row"><span>Food</span><span>₱@subtotal.ToString("N2")</span></div>
                @if (o.DeliveryFee > 0) { <div class="row"><span>Delivery fee</span><span>₱@o.DeliveryFee.ToString("N2")</span></div> }
                <div class="row total"><span>Total</span><span>₱@o.Total.ToString("N2")</span></div>
                @if (o.DepositAmount != null) { <div class="row muted"><span>Deposit</span><span>₱@o.DepositAmount.Value.ToString("N2")</span></div> }
                <div class="row muted"><span>@OrderText.PayMethodLabel(o)</span><span>@OrderText.PayStatusLabel(o)</span></div>

                @if (collect > 0)
                {
                    <div class="collect">Collect ₱@collect.ToString("N2")</div>
                    @if (o.PaymentStatus == PaymentStatus.ProofSent)
                    {
                        <div class="muted" style="text-align:center">Proof sent. Check it before collecting.</div>
                    }
                }
                else
                {
                    <div class="collect paid">PAID · nothing to collect</div>
                }
            </article>
        }
    </div>
</body>
</html>
