@model OwnerMenuVm
@{
    ViewData["Title"] = "Menu";
    ViewData["Wide"] = true;
    var catalog = Model.CatalogMeals.OrderBy(m => Array.IndexOf(MenuSeries.All, m.SeriesName)).ThenBy(m => m.Name).ToList();
    var today = Model.TodayEntries.OrderBy(e => Array.IndexOf(MenuSeries.All, e.MenuItem!.SeriesName)).ThenBy(e => e.MenuItem!.Name).ToList();
    var packages = Model.Packages.OrderBy(m => Array.IndexOf(MenuSeries.All, m.SeriesName)).ThenBy(m => m.Name).ToList();
    var todayIds = today.Select(e => e.MenuItemId).ToHashSet();
    var notToday = catalog.Where(m => !todayIds.Contains(m.Id)).ToList();
    var store = Model.Store;
    var pickedPct = catalog.Count == 0 ? 0 : today.Count * 100 / catalog.Count;
    string Pesos(decimal d) => "₱" + d.ToString("N0");
}

<section class="o-hero o-side">
    <div class="o-hero-bg" aria-hidden="true"></div>
    <div class="o-hero-in">
        <span class="o-kicker">Menu</span>
        <h1>What's cooking today?</h1>
        <p>Pick today's dishes from your catalog and say how many servings you have. Customers only see what is on today's menu.</p>
        <div class="cook-meter" role="img" aria-label="@today.Count of @catalog.Count dishes picked for today"><div style="width:@pickedPct%"></div></div>
        <span class="cook-text">@today.Count of @catalog.Count catalog dishes picked for today</span>
    </div>
</section>

<div class="tabs" role="tablist" aria-label="Menu sections" data-tabs>
    <button type="button" role="tab" class="tab" data-tab="today" aria-selected="true">Today's menu <span class="tab-n">@today.Count</span></button>
    <button type="button" role="tab" class="tab" data-tab="dishes" aria-selected="false">My dishes <span class="tab-n">@catalog.Count</span></button>
    <button type="button" role="tab" class="tab" data-tab="packages" aria-selected="false">Food packages <span class="tab-n">@packages.Count</span></button>
</div>

@* ================= Today's menu ================= *@
<section class="tab-panel" data-panel="today" role="tabpanel">
    <form asp-action="ToggleOffer" asp-route-kind="daily" method="post" class="card offer-card @(store.OffersDailyMenu ? "" : "is-off")">
        <div>
            <strong>Daily foods</strong>
            <p class="muted">@(store.OffersDailyMenu ? "On. Customers can see and order the dishes below." : "Off. Customers can't see or order daily foods.")</p>
        </div>
        <label class="switch">
            <input type="checkbox" @(store.OffersDailyMenu ? "checked" : "") onchange="this.form.submit()" aria-label="Offer daily foods" />
            <span class="slider"></span>
        </label>
    </form>

    @if (!today.Any())
    {
        <div class="banner banner-closed">
            <strong>No dishes are picked for today.</strong> Customers see an empty menu until you add some.
        </div>
    }

    <div class="page-head">
        <h2 class="section" style="margin:0">On today's menu <span class="muted" style="font-weight:400">(resets every day)</span></h2>
        @if (Model.LastMenuDate != null)
        {
            <form asp-action="CopyYesterday" method="post">
                <button class="btn btn-sm btn-outline">Copy @(Model.LastMenuDate.Value.Date == DateTime.Today.AddDays(-1) ? "yesterday's" : Model.LastMenuDate.Value.ToString("MMM d") + "'s") menu</button>
            </form>
        }
    </div>

    @if (today.Any())
    {
        <div class="card table-wrap">
            <table class="table table-stack">
                <thead>
                    <tr><th>Food</th><th class="num">Servings left</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var entry in today)
                    {
                        var m = entry.MenuItem!;
                        <tr>
                            <td>
                                <div class="menu-cell">
                                    @if (!string.IsNullOrEmpty(m.ImageUrl)) { <img class="thumb" src="@m.ImageUrl" alt="" /> }
                                    else { <span class="thumb thumb-ph"></span> }
                                    <strong>@m.Name</strong>
                                </div>
                            </td>
                            <td data-label="Servings left">
                                <form asp-action="SetStock" asp-route-entryId="@entry.Id" method="post" class="stock-form">
                                    <input class="input stock-in" type="number" name="stock" min="0" max="1000" value="@entry.Stock" placeholder="No limit" aria-label="Servings left: @m.Name" />
                                    <button class="btn-ghost">Save</button>
                                </form>
                                @if (entry.Stock == 0) { <span class="chip chip-soldout">Sold out</span> }
                            </td>
                            <td data-label="Status">
                                <form asp-action="ToggleReady" asp-route-entryId="@entry.Id" method="post" class="ready-form">
                                    <button type="submit" class="chip-btn chip @(entry.ReadyState == DishReadyState.Preparing ? "chip-preparing" : "chip-ready")">
                                        @(entry.ReadyState == DishReadyState.Preparing ? "Preparing — tap when ready" : "Ready to serve — tap to reset")
                                    </button>
                                </form>
                            </td>
                            <td class="actions">
                                <form asp-action="RemoveToday" asp-route-entryId="@entry.Id" method="post"
                                      onsubmit="return confirm('Remove @Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(m.Name)) from today\'s menu?');">
                                    <button class="btn-ghost danger">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h2 class="section">Add dishes to today's menu</h2>
    @if (!catalog.Any())
    {
        <div class="card">
            <p class="muted" style="margin:0 0 10px">You have no dishes yet. Add your first dish, then put it on today's menu.</p>
            <a class="btn btn-sm" asp-action="Create">+ Add a dish</a>
        </div>
    }
    else if (!notToday.Any())
    {
        <div class="card"><p class="muted" style="margin:0">All of your dishes are on today's menu.</p></div>
    }
    else
    {
        <div class="card table-wrap">
            <table class="table table-stack">
                <thead><tr><th>Dish</th><th class="num">Price</th><th>Servings today</th></tr></thead>
                <tbody>
                    @foreach (var m in notToday)
                    {
                        <tr>
                            <td>
                                <div class="menu-cell">
                                    @if (!string.IsNullOrEmpty(m.ImageUrl)) { <img class="thumb" src="@m.ImageUrl" alt="" /> }
                                    else { <span class="thumb thumb-ph"></span> }
                                    <strong>@m.Name</strong>
                                </div>
                            </td>
                            <td class="num" data-label="Price">@Pesos(m.Price)</td>
                            <td data-label="Servings today">
                                <form asp-action="AddToday" asp-route-menuItemId="@m.Id" method="post" class="add-today">
                                    <input class="input" name="stock" type="number" min="1" max="9999" inputmode="numeric" placeholder="Servings" aria-label="How many servings of @m.Name today (leave empty for no limit)" />
                                    <button class="btn-ghost">+ Add to daily menu</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@* ================= My dishes (the catalog) ================= *@
<section class="tab-panel" data-panel="dishes" role="tabpanel">
    <div class="page-head">
        <h2 class="section" style="margin:0">My dishes <span class="muted" style="font-weight:400">(your full catalog, edit any time)</span></h2>
        <a class="btn btn-sm btn-yellow" asp-action="Create">+ Add a dish</a>
    </div>
    @if (!catalog.Any())
    {
        <div class="card"><p class="muted" style="margin:0">Nothing in your catalog yet. Tap "+ Add a dish" above.</p></div>
    }
    else
    {
        <div class="card table-wrap">
            <table class="table table-stack">
                <thead>
                    <tr><th>Food</th><th>Series</th><th class="num">Price</th><th>Today</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var m in catalog)
                    {
                        <tr>
                            <td>
                                <div class="menu-cell">
                                    @if (!string.IsNullOrEmpty(m.ImageUrl)) { <img class="thumb" src="@m.ImageUrl" alt="" /> }
                                    else { <span class="thumb thumb-ph"></span> }
                                    <div>
                                        <strong>@m.Name</strong>
                                        @if (!string.IsNullOrEmpty(m.Description)) { <div class="muted">@m.Description</div> }
                                    </div>
                                </div>
                            </td>
                            <td data-label="Series"><span class="series-tag">@m.SeriesName</span></td>
                            <td class="num" data-label="Price">@Pesos(m.Price)</td>
                            <td data-label="Today">
                                @if (todayIds.Contains(m.Id)) { <span class="chip chip-ready">On today's menu</span> }
                                else { <span class="chip chip-soldout">Not on today's menu</span> }
                            </td>
                            <td class="actions">
                                <a class="btn-ghost" asp-action="Edit" asp-route-id="@m.Id">Edit</a>
                                <form asp-action="Delete" asp-route-id="@m.Id" method="post"
                                      onsubmit="return confirm('Delete @Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(m.Name))? This also removes it from today\'s menu.');">
                                    <button class="btn-ghost danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="muted" style="margin-top:10px;font-size:.9rem">To put a dish on today's menu, open the <strong>Today's menu</strong> tab and use <em>Add dishes to today's menu</em>.</p>
    }
</section>

@* ================= Food packages ================= *@
<section class="tab-panel" data-panel="packages" role="tabpanel">
    <form asp-action="ToggleOffer" asp-route-kind="packages" method="post" class="card offer-card @(store.OffersPackages ? "" : "is-off")">
        <div>
            <strong>Food packages</strong>
            <p class="muted">@(store.OffersPackages ? "On. Customers can order party trays and lechon." : "Off. Customers can't see or order food packages.")</p>
        </div>
        <label class="switch">
            <input type="checkbox" @(store.OffersPackages ? "checked" : "") onchange="this.form.submit()" aria-label="Offer food packages" />
            <span class="slider"></span>
        </label>
    </form>

    <div class="page-head">
        <h2 class="section" style="margin:0">Food packages <span class="muted" style="font-weight:400">(party trays and lechon, ordered ahead)</span></h2>
        <a class="btn btn-sm" asp-action="Create" asp-route-package="true">+ Add food package</a>
    </div>
    @if (!packages.Any())
    {
        <div class="card"><p class="muted" style="margin:0">No food packages yet. Tap "+ Add food package" above to offer trays or lechon with sizes.</p></div>
    }
    else
    {
        <div class="pkg-list">
            @foreach (var p in packages)
            {
                <article class="card pkg-card">
                    <div class="menu-cell">
                        @if (!string.IsNullOrEmpty(p.ImageUrl)) { <img class="thumb thumb-lg" src="@p.ImageUrl" alt="" /> }
                        else { <span class="thumb thumb-lg thumb-ph"></span> }
                        <div style="flex:1">
                            <div class="row">
                                <strong>@p.Name</strong>
                                <span class="series-tag">@p.SeriesName</span>
                            </div>
                            @if (!string.IsNullOrEmpty(p.Description)) { <div class="muted">@p.Description</div> }
                        </div>
                    </div>
                    <ul class="size-list">
                        @foreach (var o in p.Options.OrderBy(o => o.SortOrder))
                        {
                            <li><span>@o.Label</span><strong>@Pesos(o.Price)</strong></li>
                        }
                    </ul>
                    <div class="pkg-foot">
                        <form asp-action="Toggle" asp-route-id="@p.Id" method="post" class="switch-form">
                            <label class="switch">
                                <input type="checkbox" @(p.IsAvailable ? "checked" : "") onchange="this.form.submit()" aria-label="Offer today: @p.Name" />
                                <span class="slider"></span>
                            </label>
                            @if (p.CanOrder) { <span class="chip chip-ready">Offered</span> } else { <span class="chip chip-soldout">Not offered</span> }
                        </form>
                        <div class="order-actions" style="margin:0">
                            <a class="btn-ghost" asp-action="Edit" asp-route-id="@p.Id">Edit</a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post"
                                  onsubmit="return confirm('Delete @Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(p.Name))?');">
                                <button class="btn-ghost danger">Delete</button>
                            </form>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>

@section Scripts {
    <script>
        // Tabs: show one section at a time and remember which one the owner was on
        (function () {
            var tabs = document.querySelectorAll('[data-tabs] .tab');
            var panels = document.querySelectorAll('[data-panel]');
            function show(name) {
                tabs.forEach(function (t) { t.setAttribute('aria-selected', t.dataset.tab === name ? 'true' : 'false'); });
                panels.forEach(function (p) { p.hidden = p.dataset.panel !== name; });
                try { sessionStorage.setItem('menuTab', name); } catch (e) { }
            }
            var start = (location.hash || '').replace('#', '');
            try { start = start || sessionStorage.getItem('menuTab') || ''; } catch (e) { }
            if (!document.querySelector('[data-panel="' + start + '"]')) start = 'today';
            tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.dataset.tab); }); });
            show(start);
        })();
    </script>
}
