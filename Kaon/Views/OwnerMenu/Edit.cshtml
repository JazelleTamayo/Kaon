@model MenuForm
@{
    var isNew = Model.Id == 0;
    var isPackage = Model.Category == MenuItem.PackageCategory;
    ViewData["Title"] = isNew ? (isPackage ? "Add food package" : "Add a dish") : (isPackage ? "Edit food package" : "Edit dish");
    var categories = (string[])ViewBag.Categories;
    var seriesList = (string[])ViewBag.SeriesList;

    // Opened as a pop-up on the Menu page: send only the form, without the page around it
    var modal = Context.Request.Headers.ContainsKey("X-Modal");
    if (modal) Layout = null;
}

@if (!modal)
{
    <h1>@ViewData["Title"]</h1>
}

<form asp-action="Save" method="post" id="menuForm" class="dish-form" enctype="multipart/form-data" data-title="@ViewData["Title"]" data-new="@(isNew ? "1" : "0")">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ExistingImageUrl" />

    <div class="df-body">
        <div asp-validation-summary="ModelOnly" class="form-alert"></div>

        <div class="df-grid">
            <div class="df-photo">
                <span class="label">Photo</span>
                <label class="photo-pick" for="Image">
                    <img id="photoPreview" src="@Model.ExistingImageUrl" alt="" @(string.IsNullOrEmpty(Model.ExistingImageUrl) ? "hidden" : "") />
                    <span class="photo-empty" @(string.IsNullOrEmpty(Model.ExistingImageUrl) ? "" : "hidden")>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8a2 2 0 0 1 2-2h2l1.2-2h5.6L16 6h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><circle cx="12" cy="12.5" r="3.5"/></svg>
                        <strong>Add a photo</strong>
                        <small>Click to choose</small>
                    </span>
                    <span class="photo-change">@(string.IsNullOrEmpty(Model.ExistingImageUrl) ? "Choose photo" : "Change photo")</span>
                    <input asp-for="Image" type="file" accept="image/jpeg,image/png,image/webp" class="photo-input" />
                </label>
                <span class="hint">JPG, PNG or WebP, up to 5 MB.@(isNew ? "" : " Leave as is to keep the current photo.")</span>
                <span class="error" asp-validation-for="Image"></span>
            </div>

            <div class="df-fields">
                <label class="label" asp-for="Name">Name</label>
                <input class="input" asp-for="Name" placeholder="For example: Chicken Adobo" />
                <span class="error" asp-validation-for="Name"></span>

                <label class="label" asp-for="Description">Description <span class="muted" style="font-weight:400">(optional)</span></label>
                <input class="input" asp-for="Description" placeholder="For example: with rice" />
                <span class="error" asp-validation-for="Description"></span>

                <div class="two-fields">
                    <div>
                        <label class="label" asp-for="Category">Type</label>
                        <select class="input" asp-for="Category" asp-items="@(new SelectList(categories))"></select>
                        <span class="error" asp-validation-for="Category"></span>
                    </div>
                    <div>
                        <label class="label" asp-for="Series">Series</label>
                        <select class="input" asp-for="Series" asp-items="@(new SelectList(seriesList))"></select>
                    </div>
                </div>
                <span class="hint">Series lets customers filter by Chicken, Pork, Beef and so on.</span>

                <div id="mealFields">
                    <label class="label" asp-for="Price">Price (₱)</label>
                    <input class="input" asp-for="Price" type="number" step="0.01" min="0" inputmode="decimal" />
                    <span class="error" asp-validation-for="Price"></span>
                    <span class="hint">Servings are set when you add the dish to today's menu.</span>
                </div>

                <div id="pkgAvailField">
                    <label class="check">
                        <input type="checkbox" asp-for="IsAvailable" />
                        <span>Offering today</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="df-sizes" id="sizeFields">
            <strong>Sizes and portions</strong>
            <p class="muted" style="margin:2px 0 12px">
                Add each size with its price. Examples: "Small tray (6-8 people)", "Whole lechon, 8 kg", "Per kilo".
                Customers pick one when they order.
            </p>
            <div id="sizeRows">
                @for (var i = 0; i < Model.Options.Count; i++)
                {
                    <div class="size-row">
                        <input class="input" name="Options[@i].Label" value="@Model.Options[i].Label" placeholder="Size or portion, for example Small tray (6-8 people)" aria-label="Size name" />
                        <input class="input price-in" name="Options[@i].Price" value="@(Model.Options[i].Price == 0 ? "" : Model.Options[i].Price.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" type="number" step="0.01" min="0" placeholder="Price ₱" aria-label="Price" />
                        <button type="button" class="btn-ghost danger" data-remove aria-label="Remove size">Remove</button>
                    </div>
                }
            </div>
            <button type="button" class="add-row" id="addSize">+ Add another size</button>
        </div>
    </div>

    <div class="df-actions">
        @if (modal)
        {
            <button type="button" class="btn-ghost" data-dlg-close>Cancel</button>
        }
        else
        {
            <a class="btn-ghost" asp-action="Index" style="text-decoration:none">Cancel</a>
        }
        <button class="btn" type="submit">@(isNew ? "Save" : "Save changes")</button>
    </div>
</form>

@if (!modal)
{
    @section Scripts {
        <script src="~/js/menu.js" asp-append-version="true"></script>
        <script src="~/js/menu-form.js" asp-append-version="true"></script>
        <script>kaonMenuForm.init(document, '@MenuItem.PackageCategory');</script>
    }
}
