@model LoginForm
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#FFF4E3" />
    <title>Kaon admin</title>
    <link rel="icon" type="image/svg+xml" href="~/img/logo-icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="lp auth-body">
    <main class="auth-split" style="min-height:100vh">
        <aside class="auth-photo" aria-hidden="true" style="background-image:url('@Url.Content("~/img/admin-login.webp")');top:16px;height:calc(100vh - 32px);max-height:none">
            <div class="auth-photo-copy">
                <a class="lp-brand" href="/admin/login" style="color:#fff;text-decoration:none;margin-bottom:18px;display:inline-flex"><partial name="_Mark" /><span>kaon</span></a>
                <h2>Kaon admin</h2>
                <p>Onboard carinderias, manage subscriptions and keep every carinderia running.</p>
            </div>
        </aside>

        <section class="auth-main">
            <div class="auth-box">
                <span class="auth-kicker">Kaon team only</span>
                <h1 class="auth-title">Admin log in</h1>
                <p class="auth-sub">For Kaon admins. Carinderia owners log in from the main Kaon page.</p>

                <form asp-action="Index" method="post" class="auth-form" novalidate>
                    <div asp-validation-summary="ModelOnly" class="form-alert"></div>

                    <div class="fld">
                        <label class="fld-label" asp-for="Email">Email</label>
                        <div class="fld-box">
                            <svg class="fld-ico" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3.5 7.5l8.5 6 8.5-6"/></svg>
                            <input class="fld-input" asp-for="Email" type="email" autocomplete="off" placeholder="you@example.com" />
                        </div>
                        <span class="error" asp-validation-for="Email"></span>
                    </div>

                    <div class="fld">
                        <label class="fld-label" asp-for="Password">Password</label>
                        <div class="fld-box">
                            <svg class="fld-ico" viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                            <input class="fld-input" asp-for="Password" type="password" autocomplete="new-password" placeholder="Your password" />
                            <button type="button" class="fld-eye" aria-label="Show password" data-eye>
                                <svg viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                        </div>
                        <span class="error" asp-validation-for="Password"></span>
                    </div>

                    <a class="forgot" asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a>

                    <button class="btn btn-go">Log in <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
                </form>
            </div>
        </section>
    </main>
    <script src="~/js/auth.js" asp-append-version="true"></script>
</body>
</html>
