@model BillingVm
@{
    ViewData["Title"] = "Subscription";
    ViewData["Wide"] = true;
    var now = DateTime.UtcNow;
    var sub = Model.Subscription;
    var status = sub.StatusAt(now);
    var days = sub.DaysLeft(now);
    var form = ViewBag.Form as SubmitPaymentForm ?? new SubmitPaymentForm();
    var total = status == SubscriptionStatus.Trial ? Math.Max(Model.Platform.TrialDays, 1) : 30;
    var pct = status == SubscriptionStatus.Expired ? 0 : Math.Clamp(days * 100 / total, 4, 100);
    var gcash = Model.Platform.GCashNumber;
    string Chip(SubscriptionPaymentStatus s) => s switch
    {
        SubscriptionPaymentStatus.Confirmed => "chip-ready",
        SubscriptionPaymentStatus.Rejected => "chip-cancelled",
        _ => "chip-pending"
    };
}

<section class="ob-hero no-print">
    <div class="o-hero-bg" aria-hidden="true"></div>
    <header class="ob-bar">
        <div class="ob-id">
            <h1>Kaon subscription</h1>
            <span class="ob-sub">One fixed fee every month. No commission on your orders.</span>
        </div>
    </header>
</section>

<div class="grid-2">
    <div>
        <div class="card plan-card @(status == SubscriptionStatus.Expired ? "is-ended" : "")">
            <div class="plan-top">
                @switch (status)
                {
                    case SubscriptionStatus.Trial: <span class="chip chip-pending">Free month</span> break;
                    case SubscriptionStatus.Active: <span class="chip chip-ready">Active</span> break;
                    default: <span class="chip chip-cancelled">Ended</span> break;
                }
                <div class="plan-fee"><span class="muted">Monthly fee</span><strong>₱@Model.Platform.MonthlyFee.ToString("N2")</strong></div>
            </div>

            @switch (status)
            {
                case SubscriptionStatus.Trial:
                    <div class="plan-days"><span class="big">@days</span> day@(days == 1 ? "" : "s") of free access left</div>
                    <div class="meter-bar" role="progressbar" aria-valuenow="@days" aria-valuemin="0" aria-valuemax="@total"><i style="width:@pct%"></i></div>
                    <p class="muted" style="margin:8px 0 0">Your free month ends on @sub.TrialEndsAt.ToLocalTime().ToString("MMMM d, yyyy").</p>
                    break;
                case SubscriptionStatus.Active:
                    <div class="plan-days"><span class="big">@days</span> day@(days == 1 ? "" : "s") left</div>
                    <div class="meter-bar" role="progressbar" aria-valuenow="@days" aria-valuemin="0" aria-valuemax="@total"><i style="width:@pct%"></i></div>
                    <p class="muted" style="margin:8px 0 0">Paid until @sub.AccessUntil.ToLocalTime().ToString("MMMM d, yyyy").</p>
                    break;
                default:
                    <div class="plan-days">Your subscription has ended</div>
                    <p class="muted" style="margin:8px 0 0">Renew below to open your orders, menu and store again.</p>
                    break;
            }
            @if (sub.PaidUntil.HasValue && status == SubscriptionStatus.Trial)
            {
                <p class="hint" style="margin-top:10px">You already paid ahead. Billing starts after your free month and runs until @sub.PaidUntil.Value.ToLocalTime().ToString("MMMM d, yyyy").</p>
            }
        </div>

        <h2 class="section">How to pay</h2>
        <div class="card">
            <ol class="steps-num">
                <li><div>
                    <strong>Send the fee by GCash</strong>
                    @if (!string.IsNullOrWhiteSpace(gcash))
                    {
                        <div class="gcash-box">
                            <div>
                                <span class="muted">@(string.IsNullOrWhiteSpace(Model.Platform.GCashName) ? "GCash" : Model.Platform.GCashName)</span>
                                <strong>@gcash</strong>
                            </div>
                            <button type="button" class="copy-btn" data-copy="@gcash">Copy</button>
                        </div>
                    }
                    else
                    {
                        <p class="muted" style="margin:4px 0 0">The Kaon team will give you the GCash number.</p>
                    }
                </div></li>
                <li><div><strong>Take a screenshot</strong><p class="muted" style="margin:2px 0 0">Of the payment confirmation in your GCash app.</p></div></li>
                <li><div><strong>Upload it</strong><p class="muted" style="margin:2px 0 0">The Kaon team confirms it and your access is extended.</p></div></li>
            </ol>
            @if (!string.IsNullOrWhiteSpace(Model.Platform.PaymentNote)) { <p class="hint">@Model.Platform.PaymentNote</p> }
        </div>
    </div>

    <div>
        <h2 class="section" style="margin-top:0">Send my payment</h2>
        <form asp-action="Submit" method="post" enctype="multipart/form-data" class="card">
            <div asp-validation-summary="ModelOnly" class="form-alert"></div>

            @if (Model.HasPending)
            {
                <p class="muted" style="margin:0">You already sent a payment. We will confirm it soon, then you can send the next one.</p>
            }
            else
            {
                <label class="label" for="Months">How many months are you paying for?</label>
                <select class="input" id="Months" name="Months">
                    @foreach (var m in new[] { 1, 2, 3, 6, 12 })
                    {
                        <option value="@m" selected="@(form.Months == m)">@m month@(m == 1 ? "" : "s") · ₱@((Model.Platform.MonthlyFee * m).ToString("N2"))</option>
                    }
                </select>
                @Html.ValidationMessage("Months", new { @class = "error" })

                <label class="label" for="Reference">GCash reference number (optional)</label>
                <input class="input" id="Reference" name="Reference" maxlength="60" value="@form.Reference" inputmode="numeric" />

                <label class="label" for="proof">Screenshot of your payment</label>
                <input class="input" id="proof" name="proof" type="file" accept="image/jpeg,image/png,image/webp" required />
                <span class="hint">JPG, PNG or WebP, up to 5 MB.</span>
                @Html.ValidationMessage("proof", new { @class = "error" })

                <button class="btn">Send payment</button>
            }
        </form>

        <h2 class="section">Payment history</h2>
        @if (!Model.Payments.Any())
        {
            <div class="card"><p class="muted" style="margin:0">No payments yet. When you send one, it shows here.</p></div>
        }
        else
        {
            <div class="card table-wrap">
                <table class="table table-stack">
                    <thead><tr><th>Sent</th><th>Months</th><th>Amount</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.Payments)
                        {
                            <tr>
                                <td>@p.SubmittedAt.ToLocalTime().ToString("MMM d, yyyy")</td>
                                <td data-label="Months">@p.Months</td>
                                <td data-label="Amount">₱@p.Amount.ToString("N2")</td>
                                <td data-label="Status">
                                    <span class="chip @Chip(p.Status)">@p.Status</span>
                                    @if (p.Status == SubscriptionPaymentStatus.Confirmed && p.PeriodEnd.HasValue)
                                    {
                                        <div class="muted" style="font-size:.75rem">Covers until @p.PeriodEnd.Value.ToLocalTime().ToString("MMM d, yyyy")</div>
                                    }
                                    @if (p.Status == SubscriptionPaymentStatus.Rejected && !string.IsNullOrEmpty(p.ReviewNote))
                                    {
                                        <div class="muted" style="font-size:.75rem">@p.ReviewNote</div>
                                    }
                                </td>
                                <td class="actions">
                                    @if (p.Proof != null) { <a class="btn-ghost" asp-action="Proof" asp-route-id="@p.Id" target="_blank" rel="noopener">View proof</a> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
