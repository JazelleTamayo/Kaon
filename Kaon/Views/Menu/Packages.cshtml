@model List<MenuItem>
@using Kaon.Helpers
@{
    ViewData["Title"] = "Food packages";
    ViewData["Wide"] = true;
    var store = (StoreSettings)ViewBag.Store;
    var cart = CartHelper.Get(Context.Session);
    var cartTotal = cart.Sum(c => c.Price * c.Quantity);
    var seriesList = Model.GroupBy(m => m.SeriesName).OrderBy(g => Array.IndexOf(MenuSeries.All, g.Key)).ToList();
}

<a class="back-link" asp-action="Index">&larr; Back to daily menu</a>

<section class="store-head">
    <div>
        <h1>Food packages</h1>
        <p class="muted">Party trays and lechon from @store.Name. Choose a size, then tell us when you need it at checkout. Please order at least 1 day ahead.</p>
    </div>
</section>

@if (!store.IsOpen)
{
    <div class="banner banner-closed">We're closed right now. You can look at the packages, but ordering is paused.</div>
}

@if (!Model.Any())
{
    <div class="card"><p class="muted" style="margin:0">No food packages are offered yet.</p></div>
}
else
{
    <div class="filters" role="group" aria-label="Filter by series" data-filters>
        <button type="button" class="fchip on" data-series="all">All <span>@Model.Count</span></button>
        @foreach (var g in seriesList)
        {
            <button type="button" class="fchip" data-series="@g.Key">@g.Key <span>@g.Count()</span></button>
        }
    </div>

    <div class="dish-grid pkg-grid" data-grid>
        @foreach (var item in Model)
        {
            var canBuy = item.CanOrder && store.IsOpen;
            var opts = item.Options.OrderBy(o => o.SortOrder).ToList();
            <article class="dish-card @(item.CanOrder ? "" : "is-out")" id="item-@item.Id" data-series="@item.SeriesName">
                <div class="dish-img">
                    @if (!string.IsNullOrEmpty(item.ImageUrl)) { <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" /> }
                    else { <span class="dish-ph" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="8" width="16" height="12" rx="3"/><path d="M8 8a4 4 0 0 1 8 0"/></svg></span> }
                    @if (!item.CanOrder) { <span class="dish-badge badge-out">Not offered today</span> }
                </div>
                <div class="dish-body">
                    <span class="series-tag">@item.SeriesName</span>
                    <h3 class="dish-name">@item.Name</h3>
                    @if (!string.IsNullOrEmpty(item.Description)) { <p class="dish-desc">@item.Description</p> }
                    <div class="from-price">From <strong>₱@item.FromPrice.ToString("N0")</strong></div>

                    @if (canBuy)
                    {
                        <form asp-action="Add" method="post" class="pkg-form" data-pkg>
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="returnTo" value="Packages" />

                            <div class="opts" role="radiogroup" aria-label="Choose a size for @item.Name">
                                @for (var i = 0; i < opts.Count; i++)
                                {
                                    <label class="opt">
                                        <input type="radio" name="optionId" value="@opts[i].Id" data-price="@opts[i].Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" @(i == 0 ? "checked" : "") />
                                        <span class="opt-label">@opts[i].Label</span>
                                        <span class="opt-price">₱@opts[i].Price.ToString("N0")</span>
                                    </label>
                                }
                            </div>

                            <div class="pkg-buy">
                                <div class="stepper" aria-label="Quantity">
                                    <button type="button" data-dec aria-label="Less">−</button>
                                    <input name="qty" type="number" value="1" min="1" max="100" inputmode="numeric" aria-label="Quantity" />
                                    <button type="button" data-inc aria-label="More">+</button>
                                </div>
                                <button class="dish-add dish-add-wide">Add · <span data-total></span></button>
                            </div>
                        </form>
                    }
                </div>
            </article>
        }
    </div>
    <p class="muted filter-empty" data-empty hidden>Nothing in this series.</p>
}

@if (cart.Any())
{
    <a class="cartbar" asp-controller="Cart" asp-action="Index">
        <span>@cart.Sum(c => c.Quantity) item(s)</span>
        <span>View cart · ₱@cartTotal.ToString("N2")</span>
    </a>
}

@section Scripts {
    <script src="~/js/menu.js" asp-append-version="true"></script>
}
